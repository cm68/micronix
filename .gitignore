#
# Runtime litter, never a source: the simulator's lock files, its
# scratch and working disk images, editor autosaves, and the .nfs
# files a build under a mounted tree leaves behind.
#
*.lock
disks/hdinstall/m16scratch
disks/hdinstall/m5scratch
disks/hdinstall/m40mnix
disks/hdinstall/m5mnix
\#*#
.nfs*
.@__thumb/
benchmem.log
benchmem.tsv

# Local KiCad preference files never belong in the tree.
*.kicad_prl

#
# Editor and tool indices.  A ctags/etags index, macOS debug-symbol
# bundles from a gcc or clang build, and Python bytecode caches.  All
# regenerable, none is a source.
#
tags
*.dSYM/
__pycache__/
*.pyc
