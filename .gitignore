sim
core
filesystem
extra
attic
*.tar

#
# Core dumps under any name.  "core" above only catches the bare one.
#
core.*

#
# Transient.  A -delta is where the simulator puts writes to a disk
# image, so it is whatever the last run happened to leave; disks/hdinstall
# and disks/init both delete them before starting for that reason.  .mx
# is a make intermediate.
#
*-delta
*.mx

#
# Claude Code's own directory - local settings, and the worktrees it
# makes inside the repo.  There is one in there.
#
.claude/

#
# Build output.
#
# Scoped to the directories that build rather than written as *.o and
# *.a, because the tree tracks 264 .o, 51 .a and 535 .com files that are
# recovered artifacts and not output - src/micronix/lib/objects and
# everything under extra/ are full of them, and a blanket pattern would
# hide the next one somebody adds.
#
src/lib/*.o
src/lib/*.a

src/hwsim/*.o
src/hwsim/d1/*.o
src/hwsim/d1/d1

src/micronix/lib/libc/*.o
src/micronix/lib/libc/*.a
src/micronix/lib/libcpm/*.a

src/tools/dumpsec
src/tools/setdev

src/micronix/cmd/mkfs/mkfs

#
# stand/ builds a .com and several intermediates, but mwboot1.s and
# sexit.s beside them are sources, so the assembly cannot be ignored by
# extension - boot.s and mwio.s are named because they are what ccc
# leaves behind for boot.c and mwio.c.
#
src/micronix/stand/boot/*.o
src/micronix/stand/boot/boot.s
src/micronix/stand/boot/mwio.s
src/micronix/stand/boot/mwboot.com
src/micronix/stand/boot/mwboot.hex
src/micronix/stand/boot/mwboot1.abs
src/micronix/stand/boot/mwboot1.bin
src/micronix/stand/boot/mwboot1.cim
src/micronix/stand/boot/bootimg
src/micronix/stand/boot/bootimg-*
src/micronix/stand/boot/mkbootimg
src/micronix/stand/formatmw/formatmw.com
src/micronix/stand/zout/

#
# The working hard disk images.  hddma-0.blessed is the one that is
# kept - a drive that boots, to be copied and written into - and these
# are whatever the last thing to run left behind.  hddma-1 is a blank,
# which is a thing mkfs makes rather than a thing history carries.
# See disks/hdinstall/REGEN.
#
disks/hdinstall/hddma-0
disks/hdinstall/hddma-1

#
# script(1) captures.  A typescript is a recording of a terminal session
# - the console output of a simulator run, with the escape sequences it
# was drawn with - and it grows without limit while the thing runs.  Two
# got committed: disks/hdinstall/typescript at 11MB, and a run2 at 215MB
# which GitHub refuses outright, its file limit being 100MB.  Neither is
# a source and neither is reproducible, which is the test.
#
# What is worth keeping out of a session goes in a document written from
# it - disks/hdinstall/REGEN is one - not in the recording.
#
typescript
typescript.*
*.typescript

#
# Trace output.  -l points the simulator's trace at a file called logfile
# and it takes a megabyte a second with the interesting bits switched on;
# hwsim/resources/logfile reached 62MB before anyone noticed.  Named
# rather than scoped to src/hwsim/d1, which is where it lands today,
# because it has landed in two other places already.
#
logfile
logfile.*
*.trace

#
# Objects, everywhere.
#
# Each directory used to name its own, one file at a time, and that
# fails the same way every time somebody adds a source: cmd/sh listed
# parse.o and sh.o, so glob.o and hist.o were committed the day they
# were written, and src/usersim listed "sim" and not "usersim", so the
# program that directory exists to build sat in the untracked list.
# cmd/mkfs had no .gitignore at all.
#
# The 264 objects already tracked - lib/objects/libu, which are the
# whitesmiths dumps kept as a reference for reading their binaries,
# and the ones that came in with the imported trees under extra - are
# unaffected: this only decides what an untracked file does, and a
# deliberate new one still goes in with "git add -f".
#
*.o
