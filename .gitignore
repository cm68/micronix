core
filesystem
extra
attic
*.tar

#
# The one exception to "attic" above, and the reason it is written here
# rather than as a second rule in src/micronix/sys/.gitignore.
#
# That pattern has no slash, so it matches at any depth - which is what
# the top-level attic wants.  The junk drawer is at the root, and a
# nested one is nearly always the same kind of thing.  Nearly: the
# kernel's attic is the opposite.  It holds the only copy of everything
# in it (see the README beside those files), and a directory git will
# not even list is the one place a file can be lost by moving it there.
# So the directory is re-included by name.
#
# The pattern names the directory and not the files under it.  Git does
# not descend into an excluded directory, so a rule about its contents
# has no effect however it is written; re-including the directory is
# what lets git look inside at all.
#
!src/micronix/sys/attic/

#
# Core dumps under any name.  "core" above only catches the bare one.
#
core.*

#
# Transient.  A -delta is where the simulator puts writes to a disk
# image, so it is whatever the last run happened to leave; disks/hdinstall
# and disks/init both delete them before starting for that reason.  .mx
# is a make intermediate.
#
*-delta
*.mx

#
# Claude Code's own directory - local settings, and the worktrees it
# makes inside the repo.  There is one in there.
#
.claude/

#
# Build output.
#
# Scoped to the directories that build rather than written as *.o and
# *.a, because the tree tracks 264 .o, 51 .a and 535 .com files that are
# recovered artifacts and not output - src/micronix/lib/objects and
# everything under extra/ are full of them, and a blanket pattern would
# hide the next one somebody adds.
#
src/lib/*.o
src/lib/*.a

src/hwsim/*.o
src/hwsim/d1/*.o
src/hwsim/d1/d1
src/hwsim/d1/scsi-0

src/micronix/lib/libc/*.o
src/micronix/lib/libc/*.a
src/micronix/lib/libcpm/*.a

src/tools/dumpsec
src/tools/setdev

#
# The top-level host bin and the runtime beside it.  install-hwsim and
# install-usersim copy the simulators into bin/, and hostcc/hostrt put
# the cross compiler and its libraries and headers beside them.  bin,
# libexec and ccc only exist at the top of the tree because the
# compiler resolves its own pieces from argv[0] - the passes from
# bin/../libexec, the runtime from bin/../ccc/lib and the headers from
# bin/../ccc/include - so they are anchored to the root.
#
# lib and usr are the same three under the names ccc.c uses when it is
# compiled by ccc, for /bin/ccc on micronix: bin/../lib and
# bin/../usr/include.  A host build reads neither; a -DCCC build of the
# driver would, so the names stay ignored.
#
/bin/
/libexec/
/ccc/
/lib/
/usr/

#
# stand/ builds a .com and several intermediates, but mwboot1.s,
# ideboot1.s and sexit.s beside them are sources, so the assembly cannot
# be ignored by extension - boot.s and mwio.s are named because they are
# what ccc leaves behind for boot.c and mwio.c.
#
src/micronix/stand/boot/*.o
src/micronix/stand/boot/boot.s
src/micronix/stand/boot/mwio.s
src/micronix/stand/boot/mwboot.com
src/micronix/stand/boot/mwboot.hex
src/micronix/stand/boot/mwboot1.abs
src/micronix/stand/boot/mwboot1.bin
src/micronix/stand/boot/mwboot1.cim
src/micronix/stand/boot/djboot.com
src/micronix/stand/boot/djboot1.abs
src/micronix/stand/boot/djboot1.bin
src/micronix/stand/boot/ideboot.com
src/micronix/stand/boot/ideboot1.abs
src/micronix/stand/boot/ideboot1.bin
src/micronix/stand/boot/idebootimg
src/micronix/stand/boot/idebootimg-*
src/micronix/stand/boot/ncrboot.com
src/micronix/stand/boot/ncrboot1.abs
src/micronix/stand/boot/ncrboot1.bin
src/micronix/stand/boot/ncrbootimg
src/micronix/stand/boot/ncrbootimg-*
src/micronix/stand/boot/djbootimg-*
src/micronix/stand/boot/djload
src/micronix/stand/boot/bootimg
src/micronix/stand/boot/bootimg-*
src/micronix/stand/boot/mkbootimg
src/micronix/stand/formatmw/formatmw.com
src/micronix/stand/zout/

#
# The working hard disk images.  A volume is named with a .vol suffix -
# hddma-0.vol, m16a.vol, whatever an experiment is called - so one
# pattern covers all of them however they are named.
disks/hdinstall/hddma-0
*.swp
#
# The suffix is what makes that possible.  The rule here used to be
# "everything in disks/hdinstall is a leftover unless it is named back
# in", which is the awkward way round: a new script or a new reference
# image had to be added to a list here by hand, and a file that was
# neither was invisible.  Naming the volumes instead turns the directory
# around, so what is not a .vol is a real file.  disks/hdinstall holds
# the prose (README, REGEN.md), the scripts (create_vol, check_vol,
# boot_vol, runh, run), the distributed standalone and its symlinks, and
# hddma-0.blessed - the drive that is kept, one that boots, to be copied
# and written into, deliberately not a volume.
#
# A .vol is never tracked.  A drive worth keeping is kept the way
# hddma-0.blessed is, under a name that says what it is.  See
# disks/hdinstall/REGEN.md.
#
*.vol

#
# The bootable diskettes "make bootdisks" generates.  Small where a
# volume is not - 400K to 1.1M - but the same kind of thing: build
# output, regenerated from the tree by disks/bootdisks/create_bootdisk,
# and never a source.  The .img suffix is that directory's alone so that
# what is not an .img there is a real file, the way *.vol turns
# disks/hdinstall around.
#
disks/bootdisks/*.img

#
# The distribution sets dist/create_dist generates, mx2.0-8-1.IMD and
# its fellows.  Same kind of thing again: built out of the tree and
# never a source.  Both suffixes are scoped to dist/ so that what is not
# an image there - create_dist and pack.awk - stays visible, which is
# the whole reason the rule is scoped rather than *.IMD.
#
dist/*.IMD
dist/*.img

#
# A convenience symlink in that directory, to the kernel's own sys
# directory, and not a volume.  It is nobody's source.
#
disks/hdinstall/sys

#
# script(1) captures.  A typescript is a recording of a terminal session
# - the console output of a simulator run, with the escape sequences it
# was drawn with - and it grows without limit while the thing runs.  Two
# got committed: disks/hdinstall/typescript at 11MB, and a run2 at 215MB
# which GitHub refuses outright, its file limit being 100MB.  Neither is
# a source and neither is reproducible, which is the test.
#
# What is worth keeping out of a session goes in a document written from
# it - disks/hdinstall/REGEN.md is one - not in the recording.
#
typescript
typescript.*
*.typescript

#
# Trace output.  -l points the simulator's trace at a file called logfile
# and it takes a megabyte a second with the interesting bits switched on;
# hwsim/resources/logfile reached 62MB before anyone noticed.  Named
# rather than scoped to src/hwsim/d1, which is where it lands today,
# because it has landed in two other places already.
#
logfile
logfile.*
*.trace

#
# Objects, everywhere.
#
# Each directory used to name its own, one file at a time, and that
# fails the same way every time somebody adds a source: cmd/sh listed
# parse.o and sh.o, so glob.o and hist.o were committed the day they
# were written, and src/usersim listed "sim" and not "usersim", so the
# program that directory exists to build sat in the untracked list.
# cmd/mkfs had no .gitignore at all.
#
# The 264 objects already tracked - lib/objects/libu, which are the
# whitesmiths dumps kept as a reference for reading their binaries,
# and the ones that came in with the imported trees under extra - are
# unaffected: this only decides what an untracked file does, and a
# deliberate new one still goes in with "git add -f".
#
*.o

#
# ccc's per-source intermediates, written beside the .o for every .c:
# the name table (.nam), the readable tokens (.tok) and the tokenized
# source (.x).  ccc keeps its own copies in /tmp under pid names and
# deletes them; these are what an older build left in place.  The three
# .x files already tracked under extra/ are recovered artifacts, not
# these, and are unaffected.
#
*.nam
*.tok
*.x

#
# Default linker output and assembler listings.  a.out is what gcc and
# mxccc leave when no -o names one, and a .lst is the listing a build
# drops beside its source.
#
a.out
*.lst

#
# The built command binaries.  Each cmd/ directory builds a program
# named after itself, the libexec/ passes and lib/ archives build the
# same way, and src/tools builds its own host tools.  These used to be
# one-to-a-file in the directory that builds them; they are gathered
# here so the ignore rules have one home, and a new one is added here
# rather than as a new .gitignore.
#
src/micronix/cmd/ar/ar
src/micronix/cmd/asz/asz
src/micronix/cmd/awk/awk
src/micronix/cmd/cal/cal
src/micronix/cmd/cat/cat
