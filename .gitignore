#
# The overlay driver modules.  mxld links one .mod per driver against the
# kernel and cuts a page out of it, and the page is what setdev stamps
# into the slot - so both are the object files' output and neither is a
# source.  The driver's .c and the .h that describes its interface are.
#
src/micronix/sys/*.mod
src/micronix/sys/*.page

#
# Kernel images kept by hand.  kernels/ carries a set of dated ones -
# micronix.14, .161, .167, .new - that are history and are tracked, but a
# copy of the kernel under a name of its own goes stale the moment the
# kernel is rebuilt, and create_vol copies sys/unix rather than any of
# them.  See src/micronix/sys/TODO.
#
micronix.k
kernels/micronix.ccc
kernels/micronix.ccc.sym
kernels/unix.*

#
# A symlink to the usersim build, so it can be run from the tree root.
#
sim
src/lib/maketables
src/tools/*.a
src/tools/ar
src/tools/dcheck
src/tools/destdir
src/tools/disas
src/tools/doc.inl
src/tools/dump
src/tools/fsck
src/tools/icheck
src/tools/imd
src/tools/imdd
src/tools/mnix
src/tools/ncheck
src/tools/nm
src/tools/readall
src/tools/size
src/tools/test
src/tools/testfs
src/tools/zmac
src/tools/zmac.c
src/usersim/sim
src/usersim/usersim
src/usersim/maketables
src/gui
src/hwsim/resources/cold_boot_loader.bin

#
# Runtime litter, never a source: the simulator's lock files - one
# beside each disk image it holds open for writing, so a volume's is
# <volume>.vol.lock - editor autosaves, and the .nfs files a build under
# a mounted tree leaves behind.
#
*.lock
\#*#
.nfs*
.@__thumb/
benchmem.log
benchmem.tsv

# Local KiCad preference files never belong in the tree.
*.kicad_prl

#
# Editor and tool indices.  A ctags/etags index, macOS debug-symbol
# bundles from a gcc or clang build, and Python bytecode caches.  All
# regenerable, none is a source.
#
tags
*.dSYM/
__pycache__/
*.pyc
