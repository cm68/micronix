{
  "sims": {
    "q540-dual": {
      "emulator": "src/hwsim/d1",
      "kernel": "src/micronix/sys/unix",
      "boot": {
        "monitor": "src/micronix/stand/roms/mon500.bin",
        "level1": "src/micronix/stand/roms/l1boot.bin",
        "device": "hdcdma",
        "j2": "ab"
      },
      "config": {
        "xterm": ["uart0", "ttyB", "ttyC"],
        "clock": "normal"
      },
      "wiring": "wbmio",
      "root": "hdcdma:0a",
      "swap": "hdcdma:0b",
      "volumes": [
        { "controller": "hdcdma", "unit": 0, "geometry": "m40", "image": "disks/q540-dual/root.img" },
        { "controller": "hdcdma", "unit": 1, "geometry": "m40", "image": "disks/q540-dual/usr.img" }
      ]
    },
    "wren": {
      "emulator": "src/hwsim/d1",
      "kernel": "src/micronix/sys/unix",
      "boot": {
        "monitor": "src/micronix/stand/roms/mon500.bin",
        "level1": "src/micronix/stand/roms/l1boot.bin",
        "device": "hdcdma",
        "j2": "ab"
      },
      "config": {
        "xterm": ["uart0"],
        "console": "wb",
        "clock": "normal"
      },
      "wiring": "ss1",
      "root": "hdcdma:0a",
      "swap": "hdcdma:0b",
      "volumes": [
        { "controller": "hdcdma", "unit": 0, "geometry": "wren86", "image": "disks/wren.img" }
      ]
    },
    "net": {
      "emulator": "src/hwsim/d1",
      "kernel": "src/micronix/sys/unix",
      "boot": {
        "monitor": "src/micronix/stand/roms/mon500.bin",
        "level1": "src/micronix/stand/roms/l1boot.bin",
        "device": "hdcdma",
        "j2": "ab"
      },
      "config": {
        "nomon": true,
        "clock": "normal"
      },
      "wiring": "wbmio",
      "root": "hdcdma:0a",
      "swap": "hdcdma:0b",
      "volumes": [
        { "controller": "hdcdma", "unit": 0, "geometry": "m16",
          "image": "disks/net/root.vol",
          "files": [
            { "path": "/.login", "source": "src/micronix/rootfiles/login-net" },
            { "path": "/.rhosts", "source": "src/micronix/rootfiles/rhosts-net" }
          ] }
      ]
    },
    "wsc": {
      "emulator": "src/hwsim/d1",
      "kernel": "src/micronix/sys/unix",
      "boot": {
        "monitor": "src/micronix/stand/roms/mon500.bin",
        "level1": "src/micronix/stand/roms/l1boot.bin",
        "device": "hdcdma",
        "j2": "ab"
      },
      "config": {
        "nomon": true,
        "clock": "normal"
      },
      "wiring": "wbmio",
      "root": "hdcdma:0a",
      "swap": "hdcdma:0b",
      "volumes": [
        { "controller": "hdcdma", "unit": 0, "geometry": "m40", "image": "/tmp/wsc/hdcdma/root.img" },
        { "controller": "hdcdma", "unit": 1, "geometry": "m40", "image": "/tmp/wsc/hdcdma/usr.img" }
      ]
    },

    "wunderbus": {
      "emulator": "src/hwsim/d1",
      "kernel": "src/micronix/sys/unix",
      "boot": {
        "monitor": "src/micronix/stand/roms/mon500.bin",
        "level1": "src/micronix/stand/roms/l1boot.bin",
        "device": "hdcdma",
        "j2": "ab"
      },
      "config": {
        "nomon": true,
        "console": "wb",
        "clock": "normal"
      },
      "wiring": "wb,vi0=djdma,vi1=hddma,vi2=ncr",
      "root": "hdcdma:0a",
      "swap": "hdcdma:0b",
      "volumes": [
        { "controller": "hdcdma", "unit": 0, "geometry": "m40",
          "image": "disks/wunderbus/root.img" },
        { "controller": "hdcdma", "unit": 1, "geometry": "m40",
          "image": "disks/wunderbus/usr.img" }
      ]
    },

    "wunderbus-mio": {
      "emulator": "src/hwsim/d1",
      "kernel": "src/micronix/sys/unix",
      "boot": {
        "monitor": "src/micronix/stand/roms/mon500.bin",
        "level1": "src/micronix/stand/roms/l1boot.bin",
        "device": "hdcdma",
        "j2": "ab"
      },
      "config": {
        "nomon": true,
        "console": "wb",
        "clock": "normal"
      },
      "wiring": "wbmio,vi0=djdma,vi1=hddma,vi3=ncr,vi4=nic,vi5=ide",
      "root": "hdcdma:0a",
      "swap": "hdcdma:0b",
      "volumes": [
        { "controller": "hdcdma", "unit": 0, "geometry": "m40",
          "image": "disks/wunderbus-mio/root.img" },
        { "controller": "hdcdma", "unit": 1, "geometry": "m40",
          "image": "disks/wunderbus-mio/usr.img" }
      ]
    },

    "mio-cascade": {
      "emulator": "src/hwsim/d1",
      "kernel": "src/micronix/sys/unix",
      "boot": {
        "monitor": "src/micronix/stand/roms/mon500.bin",
        "level1": "src/micronix/stand/roms/l1boot.bin",
        "device": "hdcdma",
        "j2": "ab"
      },
      "config": {
        "nomon": true,
        "console": "wb",
        "clock": "normal"
      },
      "wiring": "mio2,vi0=djdma,vi1=hddma,vi3=ncr,vi4=nic,vi5=ide",
      "root": "hdcdma:0a",
      "swap": "hdcdma:0b",
      "volumes": [
        { "controller": "hdcdma", "unit": 0, "geometry": "m40",
          "image": "disks/mio-cascade/root.img" },
        { "controller": "hdcdma", "unit": 1, "geometry": "m40",
          "image": "disks/mio-cascade/usr.img" }
      ]
    },

    "ss1": {
      "emulator": "src/hwsim/d1",
      "kernel": "src/micronix/sys/unix",
      "boot": {
        "monitor": "src/micronix/stand/roms/mon500.bin",
        "level1": "src/micronix/stand/roms/l1boot.bin",
        "device": "hdcdma",
        "j2": "ab"
      },
      "config": {
        "nomon": true,
        "console": "ss1",
        "clock": "normal"
      },
      "wiring": "ss1ctl,vi0=djdma,vi1=hddma,vi2=ncr,vi3=nic,vi4=ide,vi5=hdca,vi6=disk3,vi7=disk2",
      "root": "hdcdma:0a",
      "swap": "hdcdma:0b",
      "volumes": [
        { "controller": "hdcdma", "unit": 0, "geometry": "m40",
          "image": "disks/ss1/root.img" },
        { "controller": "hdcdma", "unit": 1, "geometry": "m40",
          "image": "disks/ss1/usr.img" }
      ]
    }
  },
  "mediasets": {
    "dist8": { "volumes": [
      "dist/mx2.0-8-1.IMD", "dist/mx2.0-8-2.IMD", "dist/mx2.0-8-3.IMD",
      "dist/mx2.0-8-4.IMD", "dist/mx2.0-8-5.IMD", "dist/mx2.0-8-6.IMD",
      "dist/mx2.0-8-7.IMD", "dist/mx2.0-8-8.IMD", "dist/mx2.0-8-9.IMD"
    ] },
    "dist8all": { "volumes": [
      "dist/mx2.0-8-1.IMD", "dist/mx2.0-8-2.IMD", "dist/mx2.0-8-3.IMD",
      "dist/mx2.0-8-4.IMD", "dist/mx2.0-8-5.IMD", "dist/mx2.0-8-6.IMD",
      "dist/mx2.0-8-7.IMD", "dist/mx2.0-8-8.IMD", "dist/mx2.0-8-9.IMD",
      "dist/mx2.0-8-10.IMD", "dist/mx2.0-8-11.IMD"
    ] },
    "dist5": { "volumes": [ "dist/mx2.0-5-1.IMD" ] }
  }
}
