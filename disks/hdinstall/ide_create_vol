#!/bin/sh
#
# Make a fresh, bootable hard disk volume for the IDE card.
#
#	./ide_create_vol <volume>
#
# This is create_vol with the boot and the root device pointed at the
# IDE card (major 4) instead of the HD-DMA (major 3).  The drive
# geometry and the volume layout are the same - an IDE drive reports its
# own geometry, and a volume laid out for the HD-DMA reads back block for
# block through the IDE card, which is the whole compatibility argument.
# What differs is which level 2 is in block 0 (ideboot1 instead of
# mwboot1), and which device the kernel mounts root from.
#
# <volume> is the name of the drive file to make, given without its
# suffix: the file is made as <volume>.vol.  It is built from scratch:
# initialize lays down the blank drive with its geometry label, mkfs -i
# writes the filesystem and the IDE hard disk boot, and then the userland
# is copied across - the built binaries from the filesystem directory
# that "make install" populates, and the config (/etc, the root-level
# scripts, /dev) straight from the src/micronix tree.  The kernel is
# then replaced with the freshly built ccc one.
#
# /boot is not copied: mkfs -i has just built it for this card, and
# copying it from elsewhere would put the wrong boot over it.  /dev is
# recreated node by node rather than carried, because tar does not carry
# device nodes - the list comes from the source tree's dev/devlist.
#
# The volume is made in this directory unless an absolute path is given,
# and it is truncated if it already exists.
#

here=`dirname "$0"`
here=`cd "$here" && pwd` || exit 1
root=`cd "$here/../.." && pwd`

mnix="$root/src/tools/mnix"
setdev="$root/src/tools/setdev"
bootimg="$root/src/micronix/stand/boot/idebootimg"
devlist="$root/src/micronix/dev/devlist"
kernel="$root/src/micronix/sys/unix"
srcdir="$root/src/micronix"
srctar="$srcdir/srctar.tar"
rootfiles="$srcdir/rootfiles"
filesystem="$root/filesystem"

vol="$1"
if [ -z "$vol" ]; then
	echo "usage: $0 <volume>" >&2
	exit 1
fi
case "$vol" in
*.vol)	;;
*)	vol="$vol.vol" ;;
esac
case "$vol" in
/*)	;;
*)	vol="$here/$vol" ;;
esac

if [ ! -f "$devlist" ]; then
	echo "$0: $devlist not found - nothing to populate /dev from" >&2
	exit 1
fi
if [ ! -f "$bootimg" ]; then
	echo "$0: $bootimg not found - build the boot first:" >&2
	echo "$0:   make -C $root/src/micronix/stand/boot idebootimgs" >&2
	exit 1
fi
if [ ! -f "$filesystem/etc/init" ]; then
	echo "$0: $filesystem/etc/init not found - make install has not built init" >&2
	exit 1
fi

tmp=`mktemp` || exit 1
trap 'rm -f "$tmp" "$tmp.k"' 0

# clear any sidecar lock file the host tools leave at "<volume>.lock"
rm -f "$vol.lock"

# 1. a blank 16 meg drive
"$mnix" initialize m16 "$vol" || exit 1

# 2. the filesystem, with the IDE hard disk boot in /boot/boot
"$mnix" mkfs "$vol" -i "$bootimg" -f || exit 1

# 3. the userland, as create_vol does.
tar -C "$filesystem" -c -f "$tmp" \
	--exclude='usr/src' --exclude='usr/man' \
	bin lib libexec usr || exit 1
"$mnix" -f "$vol" tar x "$tmp" || exit 1

tar -C "$rootfiles" -c -f "$tmp" \
	finstall hdinit m5init m10init m16init .sh .login || exit 1
"$mnix" -f "$vol" tar x "$tmp" || exit 1

tar -C "$srcdir" -c -f "$tmp" etc || exit 1
"$mnix" -f "$vol" tar x "$tmp" || exit 1
"$mnix" -f "$vol" write "$filesystem/etc/init" /etc/init || exit 1

# 4. the device nodes, from the source tree's dev/devlist, and /tmp.
"$mnix" -f "$vol" mkdir /dev || exit 1
"$mnix" -f "$vol" mkdir /tmp || exit 1
while read type major minor name; do
	case "$type" in
	''|\#*)	continue ;;
	esac
	"$mnix" -f "$vol" mknod "/dev/$name" "$type" "$major" "$minor" || exit 1
done < "$devlist"

# 5. the freshly built kernel, over the one mkfs -i left.  The ccc kernel's
# root device defaults to 3/0 - the HD-DMA m5 - and the IDE card is major
# 4, so point it at 4/0: major 4 is the ide card's slot in biosw[] and
# minor 0 is drive 0 on the bus.  setdev stamps the major-4 driver module
# into the kernel's slot as it patches the device numbers, so work on a
# copy.
if [ -f "$kernel" ]; then
	cp "$kernel" "$tmp.k" || exit 1
	"$setdev" "$tmp.k" 4/0 0/0 || exit 1
	"$mnix" -f "$vol" write "$tmp.k" /micronix || exit 1
	# /dev/root names the device setdev just pointed the kernel at (4/0).
	"$mnix" -f "$vol" mknod /dev/root b 4 0 || exit 1
fi

# 6. the source tree, sources only, onto /usr/src.
make -C "$srcdir" tarfile || exit 1
"$mnix" -f "$vol" tar x -C /usr/src "$srctar" || exit 1

echo "$0: made $vol"
