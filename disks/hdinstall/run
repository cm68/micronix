#!/bin/sh
#
# Boot the Micronix 1.67 standalone with the hard disk attached.
#
#	./run			the console is this window, nothing else
#	./run -t 0x100000	and trace system calls into the logfile
#	./run -t 0x120000	system calls and every trap
#	./run -c 0x114		put the console in an xterm of its own
#
# Nothing is traced unless you ask.  Anything on the command line is
# passed through, so -t, -T, -W and -c are all available without editing
# this.
#
# If -t is given, -l goes with it: trace output is written to a file
# descriptor and -l is what points that descriptor at
# src/hwsim/d1/logfile.  Without it the trace is not produced at all, and
# with it going anywhere else it would land on top of the console.  Watch
# it from another window:
#
#	tail -f ../../src/hwsim/d1/logfile
#
# The bits, from ./d1 -h:
#
#	     1  inst	every instruction - large, and to stderr, not the log
#	    80  djdma	    100  djint
#	   800  clock
#	 20000  trap	every entry to the kernel, interrupts included
#	100000  syscall	calls and what they returned
#
here=`dirname "$0"`
here=`cd "$here" && pwd` || exit 1

# Writes to a floppy image go to a -delta beside it and stay there, so
# without this every run starts from wherever the last one left off.
for d in "$here"/*-delta; do
	if [ -f "$d" ]; then
		echo "run: discarding $d"
		rm -f "$d"
	fi
done

# -l only when there is something to log
log=
for a in "$@"; do
	case "$a" in
	-t) log=-l ;;
	esac
done

cd "$here/../../src/hwsim/d1" || exit 1

exec ./d1 -b roms/mon447.bin $log \
	-d "$here" -5 "$here/sa67.5.skew.1k" "$@"
