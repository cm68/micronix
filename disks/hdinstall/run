#!/bin/sh
#
# Boot the Micronix 1.67 standalone with its console in an xterm, ready
# to install onto the simulated hard disk.  Type the command yourself
# when it is time - see below for when that is.
#
#	./run			system calls, traced to the logfile
#	./run -t 0x120000	system calls and every trap as well
#	./run -t 0x800		just the clock, if that is the question
#
# The trace goes to src/hwsim/d1/logfile and not to this window - trace()
# writes to a file descriptor, and -l is what points that descriptor at
# the logfile.  Watch it from another window with
#
#	tail -f ~/src/micronix/src/hwsim/d1/logfile
#
# The instruction trace is the exception: -t 1 goes to stderr, so it does
# land in this window.
#
# Anything given on the command line is passed through, so -T and the
# rest are available without editing this.
#
# The trace bits worth knowing, from ./d1 -h in src/hwsim/d1:
#
#	    800  clock	every tick
#	  20000  trap	every entry to the kernel - interrupts as well as
#			system calls, which is most of them: a quiet boot
#			is nearly four thousand interrupts to fifty calls
#	 100000  syscall
#
# -c 0x114 is three things: 0x100 puts uart 0 - the console - in an xterm
# of its own instead of borrowing this window, 0x10 boots the djdma
# floppy, and 0x04 says do not stop in the monitor first.  Add 0x1000 for
# a machine with no clock, which is a thing you can want and not a thing
# you want by accident.
#
here=`dirname "$0"`
here=`cd "$here" && pwd` || exit 1

# Writes to a floppy image go to a -delta beside it and stay there, so
# without this every run starts from wherever the last one left off.
for d in "$here"/*-delta; do
	if [ -f "$d" ]; then
		echo "run: discarding $d"
		rm -f "$d"
	fi
done

cat <<'NOTE'
run: the console is the xterm.  The trace is in
     src/hwsim/d1/logfile - tail -f it from another window.

     Wait for the welcome to finish printing in the xterm - it ends
     "...Micronix User's Manual." - and then wait a little longer.  The
     shell prints no prompt, so that last line is the prompt.  Anything
     typed before it arrives is discarded when the shell sets up the
     terminal, which looks exactly like the machine ignoring you.

     Then, in the xterm:

         source m5init

     mkfs, fsck, mount, cptree the system across, relink root and swap,
     patch the kernel, unmount.  It ends "Disk initialization complete."
     cptree is copying a filesystem through a simulated Z80, so it takes
     a while, and the trace in logfile is how you watch it work.

NOTE

cd "$here/../../src/hwsim/d1" || exit 1

exec ./d1 -b roms/mon447.bin -c 0x114 -t 0x100000 -l \
	-d "$here" -5 "$here/sa67.5.skew.1k" "$@"
