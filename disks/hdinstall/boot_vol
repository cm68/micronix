#!/bin/sh
#
# Boot the hardware simulator from a hard disk volume.
#
#	./boot_vol <volume>
#
# <volume> is the name of the drive file to boot - the thing create_vol
# makes - given without its .vol suffix.  The simulator reads the monitor
# ROM, which reads the first level loader off cylinder 0, which reads the
# second level, which loads /micronix off the filesystem.
#
# -c 0x70c is the configuration switch, one number that says four things
# at once: 0x08 boot the HD-DMA, 0x04 skip the monitor and go straight to
# the boot, and 0x700 put all three uarts in xterms of their own - uart 0,
# the console, plus ttyB and ttyC - rather than borrowing this window.
# The console bit is what lets this script be run from anywhere and keeps
# the console from wedging the shell it was started from; the ttyB/ttyC
# bits are what give the multiuser logins a window to live in.
#
# Every argument before <volume> is a simulator flag, so the usual
# -t/-T/-W/-c switches are available without editing this.
#

here=`dirname "$0"`
here=`cd "$here" && pwd` || exit 1
root=`cd "$here/../.." && pwd`

# The kernel this volume boots is the one create_vol wrote to /micronix:
# the freshly linked ccc kernel at src/micronix/sys/unix.  Point -S at
# that same file, so the tracer resolves kernel symbols against the
# kernel that actually boots - not a stale copy from kernels/.
kernel="$root/src/micronix/sys/unix"

# The volume is the last argument; every argument before it is a
# simulator flag, passed through in order.
flags=""
while [ $# -gt 1 ]; do
	if [ "$1" = "-h" ]; then
		echo "usage: $0 [simulator flags] <volume>"
		exit 0
	fi
	flags="$flags $1"
	shift
done
vol="$1"

if [ "$vol" = "-h" ]; then
	echo "usage: $0 [simulator flags] <volume>"
	exit 0
fi
if [ -z "$vol" ]; then
	echo "usage: $0 [simulator flags] <volume>" >&2
	exit 1
fi

case "$vol" in
*.vol)	;;
*)	vol="$vol.vol" ;;
esac
case "$vol" in
/*)	;;
*)	vol="$here/$vol" ;;
esac

cd "$root/src/hwsim/d1" || exit 1
exec ./d1 -b ../../micronix/stand/roms/mon447.bin -c 0x70c -S "$kernel" $flags "hdcdma0:$vol"
