#!/bin/sh
#
# boot the 1.67 standalone with its console in an xterm
#
# The deltas go first, before anything else happens.  Writes to a floppy
# image do not go to the image, they go to a -delta file beside it, and
# that file is still there next time - so a second run does not start
# from the distributed disk, it starts from wherever the last run left
# off.  Run out of space once and every run afterwards is out of space
# before it begins, which reads as the same failure repeating rather than
# as one failure being inherited.
#
# -t 0x80000 is the system call trace.  It goes to stdout, which is the
# window this was started from, so the calls scroll past there while the
# console has the xterm to itself.  Each line says which task made the
# call and from what address, so anything interesting can be handed
# straight back to -T as a trace trigger.
#
# -c 0x114 is three things at once: 0x100 puts uart 0 - the console - in
# an xterm instead of borrowing the terminal this was started from, 0x10
# selects the djdma floppy as the boot device, and 0x04 says do not stop
# in the monitor first.  0x14 is what the switches default to; the 0x100
# is the part worth remembering.
#
here=`dirname "$0"`
here=`cd "$here" && pwd` || exit 1

for d in "$here"/*-delta; do
	if [ -f "$d" ]; then
		echo "run: discarding $d"
		rm -f "$d"
	fi
done

cd "$here/../../src/hwsim/d1" || exit 1

exec ./d1 -b roms/mon447.bin -c 0x114 -t 0xfffff -d "$here" -5 "$here/sa67.5.skew.1k"
