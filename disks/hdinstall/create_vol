#!/bin/sh
#
# Make a fresh, bootable 40 meg hard disk volume.
#
#	./create_vol <volume>
#
# <volume> is the name of the drive file to make.  It is built from
# scratch: initialize lays down the blank drive with its geometry label,
# mkfs -i writes the filesystem and the m40 hard disk boot, and then the
# whole userland is copied across from the blessed drive.  The kernel is
# then replaced with the freshly built ccc one.
#
# The blessed drive (hddma-0.blessed) is the source of "all the
# binaries" - the original userland exactly as distributed, kept as a
# fixed reference.  /boot is not copied: mkfs -i has just built it for
# the m40, and copying the blessed drive's would put the m5 boot over
# it.  /dev is recreated node by node rather than carried, because tar
# does not carry device nodes.
#
# The volume is made in this directory unless an absolute path is given,
# and it is truncated if it already exists.
#

here=`dirname "$0"`
here=`cd "$here" && pwd` || exit 1
root=`cd "$here/../.." && pwd`

mnix="$root/src/tools/mnix"
setdev="$root/src/tools/setdev"
blessed="$here/hddma-0.blessed"
bootimg="$root/src/micronix/stand/boot/bootimg-m40"
kernel="$root/src/micronix/sys/unix"
srcdir="$root/src/micronix"
srctar="$srcdir/srctar.tar"

vol="$1"
if [ -z "$vol" ]; then
	echo "usage: $0 <volume>" >&2
	exit 1
fi
case "$vol" in
/*)	;;
*)	vol="$here/$vol" ;;
esac

if [ ! -f "$blessed" ]; then
	echo "$0: $blessed not found - nothing to populate from" >&2
	exit 1
fi
if [ ! -f "$bootimg" ]; then
	echo "$0: $bootimg not found - build the boot first:" >&2
	echo "$0:   make -C $root/src/micronix/stand INC=/usr/local/usr/include bootimgs" >&2
	exit 1
fi

tmp=`mktemp` || exit 1
trap 'rm -f "$tmp" "$tmp.dev" "$tmp.k"' 0

# 1. a blank 40 meg drive
"$mnix" initialize m40 "$vol" || exit 1

# 2. the filesystem, with the hard disk boot in /boot/bootmw
"$mnix" mkfs "$vol" -i "$bootimg" -f || exit 1

# 3. the userland, from the blessed drive
"$mnix" -f "$blessed" tar c "$tmp" \
	/micronix /bin /etc /usr \
	/finstall /hdinit /m5init /m10init /m16init \
	/.sh /.login || exit 1
"$mnix" -f "$vol" tar x "$tmp" || exit 1

# 4. the device nodes, replayed from the blessed drive's /dev
"$mnix" -f "$vol" mkdir /dev || exit 1
"$mnix" -f "$blessed" devlist > "$tmp.dev" || exit 1
while read type major minor name; do
	"$mnix" -f "$vol" mknod "/dev/$name" "$type" "$major" "$minor" || exit 1
done < "$tmp.dev"

# 5. the freshly built kernel, over the blessed one.  The ccc kernel's
# root device defaults to 3/0 - the m5 drive type - and the m40 is minor
# 16, so point it there first: the minor's upper bits are the specs[]
# index that supplies the drive timing the label does not carry.  setdev
# patches in place, so work on a copy.
if [ -f "$kernel" ]; then
	cp "$kernel" "$tmp.k" || exit 1
	"$setdev" "$tmp.k" 3/16 0/0 || exit 1
	"$mnix" -f "$vol" write "$tmp.k" /micronix || exit 1
fi

# 6. the source tree, sources only, onto /usr/src.  "make tarfile"
# stages exactly the sources - no .o or built binaries - into one tar.
make -C "$srcdir" tarfile || exit 1
"$mnix" -f "$vol" tar x -C /usr/src "$srctar" || exit 1

echo "$0: made $vol"
