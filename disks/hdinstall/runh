#!/bin/sh
#
# Boot the newly built kernel from the hard disk.
#
# Writes the freshly built kernel (src/micronix/sys/unix) onto the drive
# as /micronix, then boots it off the HD-DMA path - the same boot
# the hardware does: the monitor ROM reads the first-level loader off
# cylinder 0 and that reads /micronix off the filesystem.  -B hdcdma is
# the "skip the monitor, boot the HD-DMA" switch.  ./run is the
# floppy-side boot; this one boots straight off the drive.
#
#	./runh			the console is this window, nothing else
#	./runh -t 0x100000	trace syscalls into the logfile
#	./runh -c 0x114		console in an xterm of its own
#	./runh work		boot a specific drive (default hddma-0)
#
# A drive is named without its .vol suffix, the way create_vol makes it.
#
# The drive is written in place, so start from a copy of the blessed
# drive rather than the blessed drive itself:
#
#	cp hddma-0.blessed mine.vol
#	./runh mine
#
# Build the kernel first if ../../src/micronix/sys/unix is missing:
#	make -C ../../src/micronix/sys unix
#
# The kernel is read where the build puts it.  It used to be copied to
# kernels/micronix.ccc first - the suffix told a ccc-built kernel from a
# Whitesmiths one, which the tree can no longer build - and the copy went
# stale the moment it was made.
#

here=`dirname "$0"`
here=`cd "$here" && pwd` || exit 1
root=`cd "$here/../.." && pwd`

# First positional argument names the drive file; the rest go to d1.
# The .vol suffix is added here unless it is already there, the same way
# create_vol names what it makes.
drive=hddma-0
case "$1" in
-*|"")	;;
*)	drive=$1; shift ;;
esac
case "$drive" in
*.vol)	;;
*)	drive="$drive.vol" ;;
esac

kernel="$root/src/micronix/sys/unix"
if [ ! -f "$kernel" ]; then
	echo "runh: $kernel not found" >&2
	echo "runh: build it first:" >&2
	echo "runh:   make -C ../../src/micronix/sys unix" >&2
	exit 1
fi

# Put the new kernel on the drive.  Plain write (not -k): the built
# kernel is a different size than what shipped, so the file moves.
"$root/src/tools/mnix" -f "$here/$drive" write "$kernel" /micronix

# -l only when there is something to log
log=
for a in "$@"; do
	case "$a" in
	-t) log=-l ;;
	esac
done

cd "$root/src/hwsim/d1" || exit 1

exec ./d1 -b ../../micronix/stand/roms/mon447.bin -B hdcdma $log "hdcdma0:$here/$drive" "$@"
