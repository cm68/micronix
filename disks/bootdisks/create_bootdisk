#!/bin/sh
#
# Make a bootable install diskette.
#
#	./create_bootdisk <medium> [<image>] [<target>]
#
# <medium> is one of the three this tree builds for, by the same names
# stand/boot's FLOPPIES table and mkbootimg use:
#
#	d8ss	8 inch, single sided	77 cyl, 1 head,  15 x 512, 1125 blocks
#	d8ds	8 inch, double sided	77 cyl, 2 heads, 15 x 512, 2250 blocks
#	d5ds	5 1/4 inch, double sided 40 cyl, 2 heads, 10 x 512, 760 blocks
#
# <target> is the controller the diskette installs onto: hdcdma (the
# Morrow HD-DMA), ide (the 8255/ATA card), scsi (the NCR 5380) or hdca
# (the Discus M26).  hdcdma by default.  It picks the init script that
# does the install and the controller's 4k level 2 boot, so a diskette is
# one article for one controller and the default is what "make
# bootdisks" builds.  An install onto another controller wants its own:
#
#	./create_bootdisk d8ss /tmp/d8ss-ide.img ide
#
# The image is made as <medium>.img in this directory unless the second
# argument names another path, and it is truncated if it already exists.
#
# It is one article, made in one pass.  mnix bootflop lays down the boot
# in the sectors in front of the filesystem and the filesystem behind it,
# both described by one struct dlabel that came in with the boot - which
# is why the medium is named once, here, and nowhere else.  What is left
# is to fill the filesystem: the userland a hard disk install needs, the
# device nodes, and the kernel, pointed at the diskette as its own root.
#
# What the diskette is for: booting it gives a system whose root is the
# floppy, off which the target's init script mkfs's a hard disk, copies
# this whole filesystem onto it with cptree, and points that kernel at
# the drive.
# So the contents are not a tool bag, they are the smallest micronix
# that can do that - see the knapsack in the README beside this file.
# Nothing that is only useful on a running system with a hard disk is
# here: no compiler, no sources, no man pages.
#
# /b and /f are made because that is where the init script and finstall
# mount: an empty directory is a mount point, and mount does not make one.
#
# The kernel's root device is the diskette's own.  The number is the
# DJ-DMA's minor for drive 0 of that size - bit 2 set is 5 1/4 inch,
# clear is 8 inch - and the alternation bit is deliberately clear: this
# is an unskewed image, which is what mnix and the loader both read.
# See imdlib.c's raw_geometry for what the bits mean, and REGEN.md for the
# shipped standalone, which is skewed and reached by a name that says so;
# this diskette is read by number instead, by the loader and by mnix.
#

here=`dirname "$0"`
here=`cd "$here" && pwd` || exit 1
root=`cd "$here/../.." && pwd`

# -m makes the maintenance diskette: the same boot and root, with fsck,
# label and the operator commands, and without the install script.  It
# is for repairing a hard disk, not for making one, so it is the article
# that carries the tools the install diskette has no room for and no use
# for.  The option comes before the medium and the rest of the arguments
# keep their positions after it.
maint=0
case "$1" in
-m|--maintenance) maint=1; shift ;;
esac

# The target is read here, before the boot image below can want it, and
# not with the other two arguments further down.
target="$3"
[ -z "$target" ] && target=hdcdma

mnix="$root/src/tools/mnix"
imd="$root/src/tools/imd"
setdev="$root/src/tools/setdev"
strip="$root/src/tools/strip"
devlist="$root/src/micronix/dev/devlist"
kernel="$root/src/micronix/sys/unix"
srcdir="$root/src/micronix"
rootfiles="$srcdir/rootfiles"
filesystem="$root/filesystem"
bootdir="$srcdir/stand/boot"

#
# The hard disk boot the install writes.  The target's init script mkfs's
# the drive and then reads a boot into the area mkfs reserved for it, out
# of the file mkfs names by default - /bootmw.bin, on the diskette that is
# running the install (mkfs.h DEFBOOT).  Without it the drive comes out
# with a zeroed boot area, which mounts and passes fsck and does not boot,
# so the file is here or the diskette cannot do the one job it has.
#
# One image serves every drive on a controller, because the geometry is
# not in it.  The label is written by the mkfs the init script runs, on
# the target machine, out of the drive node - the only thing that knows
# what the drive is.  So the target names the controller's level 2, and
# each controller has its own: bootimg for the HD-DMA, idebootimg for
# the IDE card, ncrbootimg for the NCR 5380 and hdcabootimg for the
# HDCA.  Each is about 4k, eight blocks of the five inch diskette's
# twenty-five free.
#
case "$target" in
hdcdma)	hdinit="$bootdir/bootimg" ;;
ide)	hdinit="$bootdir/idebootimg" ;;
scsi)	hdinit="$bootdir/ncrbootimg" ;;
hdca)	hdinit="$bootdir/hdcabootimg" ;;
*)	echo "$0: $target is not a controller this tree builds for" >&2
	echo "$0: targets: hdcdma ide scsi hdca" >&2
	exit 1 ;;
esac

#
# What goes in /bin.  Not a copy of the tree's bin: this is the list the
# install runs on, and one command short of it is an install that stops
# half way - mkfs, mount, cptree, mknod and setdev are the init
# script's own steps, and sh and init are how a session starts.
#
# era is deliberately absent, and no init script calls it: it is a
# Whitesmiths command this tree has never built, so a diskette that
# carried the original text would leave the new hard disk's /dev/root
# pointing at the floppy.  See rootfiles/hdcdmainit.
#
# chg is the way a running diskette reaches the medium in another drive,
# and fdj the way it formats one, so the two together are what lets a
# booted system make a diskette set of its own: "chg djdma:1
# blank:dist-1.img; fdj format djdma:1; mount it; copy; umount" needs no
# host tool at all.  Neither is an install step, so neither is on the
# install diskette - they are on the maintenance one.
#
# halt is the other end of the install: a diskette that has just written
# a hard disk stops the machine with "sync; halt", and that is what syncs
# the new superblock and lets the simulation end cleanly instead of being
# killed.  format is the one formatter for every controller - it reads
# the controller from the device node - so the diskette that installs
# onto any of them can also lay the drive down first.
#
BINS="sh rm mkfs mount umount chmod cptree mknod setdev ln sync echo
	format halt"

#
# What the install diskette carries is what the install needs and
# nothing else, and it is the same set on both media.  The init scripts
# drive mkfs, mount, cptree, mknod, setdev, rm, ln, chmod, sync, echo
# and halt; format is there because a drive has to be laid down before
# mkfs can read its label, and the operator runs it with the model or
# geometry the drive is.  fsck is deliberately absent: an install makes
# a new filesystem, and checking the one it just made is not a step that
# can repair anything.  The operator commands, the diskette-to-diskette
# loop and the repair tools are on the maintenance diskette instead.
#
MAINTBINS="sh login ls cp mv rm cat mkdir mkfs fsck mount umount chmod
	cptree mknod setdev ln sync echo format label chg fdj halt"
# The five inch maintenance set: the repair tools, without the operator
# login and the diskette-to-diskette loop, which are what will not fit
# beside the kernel.  fsck, label, format, mount and the file tools are
# the repair, and they do fit.
MAINT5="sh rm mkfs fsck mount umount chmod cptree mknod setdev ln
	sync echo halt format label ls cp mv cat mkdir"

medium="$1"
image="$2"
if [ -z "$medium" ]; then
	echo "usage: $0 [-m] <medium> [<image>] [<target>]" >&2
	echo "media: d8ss d8ds d5ds d5soft" >&2
	echo "targets: hdcdma ide scsi hdca (hdcdma by default)" >&2
	echo "-m makes the maintenance diskette, not the install one" >&2
	exit 1
fi

#
# The medium table, and the only place the three answers are written
# down: which boot image, which minor the diskette's own root node
# carries, and whether the raw image needs repacking into 1K sectors.
#
case "$medium" in
d8ss)	bootimg="djbootimg-d8ss"; rootmin=0; imd2="" ;;
d8ds)	bootimg="djbootimg-d8ds"; rootmin=0; imd2="" ;;
d5ds)	bootimg="djbootimg-d5ds"; rootmin=4; imd2="" ;;
d5soft)	bootimg="djbootimg-d5soft"; rootmin=4; imd2="-2" ;;
*)	echo "$0: $medium is not a medium this tree builds" >&2
	echo "$0: media: d8ss d8ds d5ds d5soft" >&2
	exit 1 ;;
esac
bootimg="$bootdir/$bootimg"

# The maintenance diskette carries the repair set, not the install one.
if [ "$maint" = 1 ]; then
	case "$medium" in
	d5ds|d5soft)	BINS="$MAINT5" ;;
	*)		BINS="$MAINTBINS" ;;
	esac
fi

if [ -z "$image" ]; then
	image="$here/$medium.img"
fi
case "$image" in
/*)	;;
*)	image="$here/$image" ;;
esac

if [ ! -f "$devlist" ]; then
	echo "$0: $devlist not found - nothing to populate /dev from" >&2
	exit 1
fi
if [ ! -f "$bootimg" ]; then
	echo "$0: $bootimg not found - build the boot images first:" >&2
	echo "$0:   make -C $srcdir/stand/boot djbootimgs" >&2
	exit 1
fi
if [ ! -f "$hdinit" ]; then
	echo "$0: $hdinit not found - build the boot images first:" >&2
	echo "$0:   make -C $srcdir/stand/boot bootimgs" >&2
	exit 1
fi
if [ ! -f "$rootfiles/${target}init" ]; then
	echo "$0: $rootfiles/${target}init not found - there is no install" >&2
	echo "$0: targets: hdcdma ide scsi hdca" >&2
	exit 1
fi
if [ ! -f "$filesystem/etc/init" ]; then
	echo "$0: $filesystem/etc/init not found - make install has not built init" >&2
	exit 1
fi

tmp=`mktemp` || exit 1
trap 'rm -f "$tmp" "$tmp.k"; rm -rf "$tmp-stripped"' 0

# clear any sidecar lock file the host tools leave at "<image>.lock",
# and the write overlay "<image>-delta" whose dirty sectors survive a
# rebuilt .img and would hand the loader the previous build's filesystem.
rm -f "$image.lock" "$image-delta"

# 1. the boot and the filesystem, one label describing both
"$mnix" bootflop "$bootimg" "$image" || exit 1

# 2. the userland.  The built binaries come from the source tree's
# filesystem (make install); the config is that same directory's etc,
# which is where the built init is and where signon2 lives - the signon
# the init script installs in place of the plain one.
#
# The binaries are stripped before they go on the diskette.  A Whitesmiths
# image carries its symbol table after its text and data, and on a disk
# the size of these nothing reads it - the kernel is the one exception,
# because its overlay modules ride in its own file and the symbol table
# is part of what it opens.  So the commands are copied, stripped, and
# then archived from the stripped copies, and the kernel below is written
# as it was built.
stripped="$tmp-stripped"
mkdir -p "$stripped/bin" || exit 1
for f in $BINS; do
	cp "$filesystem/bin/$f" "$stripped/bin/$f" || exit 1
	"$strip" "$stripped/bin/$f" || exit 1
done
set --
for f in $BINS; do
	set -- "$@" "bin/$f"
done
tar -C "$stripped" -c -f "$tmp" "$@" || exit 1
"$mnix" -f "$image" tar x "$tmp" || exit 1

tar -C "$filesystem" -c -f "$tmp" etc || exit 1
"$mnix" -f "$image" tar x "$tmp" || exit 1

if [ "$maint" = 1 ]; then
	tar -C "$rootfiles" -c -f "$tmp" .sh || exit 1
else
	tar -C "$rootfiles" -c -f "$tmp" "${target}init" .sh || exit 1
fi
"$mnix" -f "$image" tar x "$tmp" || exit 1

# 3. the device nodes, from the source tree's dev/devlist, and the
# mount points and /tmp, which no tar carried - it archives files, not
# empty directories.
"$mnix" -f "$image" mkdir /dev || exit 1
"$mnix" -f "$image" mkdir /tmp || exit 1
"$mnix" -f "$image" mkdir /b || exit 1
"$mnix" -f "$image" mkdir /f || exit 1
while read type major minor name; do
	case "$type" in
	''|\#*)	continue ;;
	esac
	"$mnix" -f "$image" mknod "/dev/$name" "$type" "$major" "$minor" || exit 1
done < "$devlist"

# 4. the freshly built kernel, and the diskette's own root node.  The
# ccc kernel's root device defaults to 3/0 and this diskette's root is
# the floppy it booted from, so point it there: setdev patches in place,
# so work on a copy.  Swap stays nodev, which is what a floppy system
# wants - a system that does not swap is better than one that swaps onto
# the diskette it is running from.
if [ -f "$kernel" ]; then
	cp "$kernel" "$tmp.k" || exit 1
	"$setdev" "$tmp.k" "2/$rootmin" 0/0 || exit 1
	"$mnix" -f "$image" write -s "$tmp.k" /micronix || exit 1
	"$mnix" -f "$image" mknod /dev/root b 2 "$rootmin" || exit 1
fi

# 5. the hard disk's boot image, under the name mkfs reads by default.
# It is not the diskette's own boot - that is in the sectors in front of
# the filesystem and came in with step 1 - but the boot of the drive the
# install is about to make.
"$mnix" -f "$image" write "$hdinit" /bootmw.bin || exit 1

# 6. A 1K medium's physical sectors are 1024 bytes, but the raw image
# built above is 512 byte blocks - the unit mnix writes a filesystem in.
# Re-pack it into 1024 byte sectors so the simulator reads it the way a
# real drive lays it down.  The boot is not alternated: a bootdiskette is
# unskewed, and the loader reads straight.
if [ -n "$imd2" ]; then
	"$imd" -m $imd2 "$image" > /dev/null 2>&1 || exit 1
	mv "$image-merge" "$image" || exit 1
	rm -f "$image-delta"
fi

echo "$0: made $image"
