Name     Z280 S-100 CPU card - data-path CPLD ;
PartNo   ATF1508 ;
Date     2026-08-20 ;
Revision 0 ;
Designer ;
Company  ;
Assembly ;
Location ;
Device   f1508ispplcc84 ;

/* ============================================================================
 * Z280 S-100 CPU card - data-path CPLD (CPLD B)
 *
 * The byte-steered data switch. AD0-15 (16 bidir) hangs on the shared AD bus
 * (Z280 + SRAM + flash + latch); DO0-7 / DI0-7 (16 bidir) go straight to the
 * S-100 edge. Internally it does the IEEE-696 even/odd mux (DO=even, DI=odd)
 * and the 8-bit byte steering, plus the slave-side SIXTN/pRDY/XRDY open-drain
 * drive and the address/status/control buffer OE/DIR.
 *
 * Control CPLD (A) feeds it: SLAVE, SLAVE_WIN, MASTER_ACTIVE, MASTER_WRITE,
 * BYTE_SEL, XFR16. It reads the bus status/disable lines itself.
 *
 * Pinout verified against the ATF1508 84-pin PLCC: JTAG = TDI 14 / TMS 23 /
 * TCK 62 / TDO 71 (dedicated). 63 general I/O used; pin 84 (OE1) is spare.
 * ========================================================================== */

/* *************** INPUT PINS *********************/
PIN 1   = SLAVE;         /* from A: board is a bus slave */
PIN 2  = A16;          /* high address lines (decode only) */
PIN 4  = A17;
PIN 5  = A18;
PIN 6  = A19;
PIN 8  = A20;
PIN 9  = A21;
PIN 10  = A22;
PIN 11  = A23;
PIN 12   = MASTER_ACTIVE; /* from A: master FSM driving an S-100 cycle */
PIN 15   = MASTER_WRITE;  /* from A: master write */
PIN 16   = BYTE_SEL;      /* from A: 0=even, 1=odd */
PIN 17   = XFR16;         /* from A: 16-bit transfer */
PIN 18   = S100_sMEMR;    /* bus status, active high */
PIN 20   = S100_sWO;      /* bus status, active low (write) */
PIN 21   = S100_sXTRQ;    /* bus 16-bit request, active low */
PIN 22  = S100_ADSB;     /* address disable, active low */
PIN 24  = S100_DODSB;    /* data-out disable, active low */
PIN 25  = S100_SDSB;     /* status disable, active low */
PIN 27  = S100_CDSB;     /* control disable, active low */
PIN 62  = TCK;
PIN 23  = TMS;
PIN 14  = TDI;

/* *************** DATA BIDIR PINS *********************/
PIN 28  = AD0;
PIN 29  = AD1;
PIN 30  = AD2;
PIN 31  = AD3;
PIN 33  = AD4;
PIN 34  = AD5;
PIN 35  = AD6;
PIN 36  = AD7;
PIN 37  = AD8;
PIN 39  = AD9;
PIN 40  = AD10;
PIN 41  = AD11;
PIN 44  = AD12;
PIN 45  = AD13;
PIN 46  = AD14;
PIN 48  = AD15;
PIN 49  = S100_DO0;
PIN 50  = S100_DO1;
PIN 51  = S100_DO2;
PIN 52  = S100_DO3;
PIN 54  = S100_DO4;
PIN 55  = S100_DO5;
PIN 56  = S100_DO6;
PIN 57  = S100_DO7;
PIN 58  = S100_DI0;
PIN 60  = S100_DI1;
PIN 61  = S100_DI2;
PIN 63  = S100_DI3;
PIN 64  = S100_DI4;
PIN 65  = S100_DI5;
PIN 67  = S100_DI6;
PIN 68  = S100_DI7;

/* *************** OUTPUT PINS *********************/
PIN 69  = SRAM_WIN;      /* to A: 2 MB window (000000-1FFFFF) */
PIN 70  = FLASH_WIN;     /* to A: F00000-F3FFFF */
PIN 73  = BANK;          /* to A: bank select (A20) */
PIN 74  = !S100_A_OE;    /* address buffer enable, active low */
PIN 75  = S100_A_DIR;    /* address buffer direction */
PIN 76  = !S100_S_OE;    /* status buffer enable, active low */
PIN 77  = !S100_C_OE;    /* control buffer enable, active low */
PIN 79  = S100_SC_DIR;   /* status/control buffer direction */
PIN 80  = S100_pRDY;     /* open-drain ready */
PIN 81  = S100_XRDY;     /* open-drain extended ready */
PIN 83  = !S100_SIXTN;   /* 16-bit acknowledge, active low, open-drain */
PIN 71  = TDO;

/* *************** DIRECTION *************** */
XFER_WRITE = (MASTER_ACTIVE & MASTER_WRITE & S100_DODSB) # (SLAVE & S100_sWO & SLAVE_WIN);
XFER_READ  = (MASTER_ACTIVE & !MASTER_WRITE) # (SLAVE & !S100_sWO & SLAVE_WIN);

/* Drive the AD bus (data flows S-100 -> AD): master read, slave write. */
DRIVE_AD = (MASTER_ACTIVE & !MASTER_WRITE) # (SLAVE & S100_sWO & SLAVE_WIN);
/* Drive DO (even byte): master write, or slave 16-bit read. */
DRIVE_DO = (MASTER_ACTIVE & MASTER_WRITE) # (SLAVE & !S100_sWO & SLAVE_WIN & XFR16);
/* Drive DI (odd byte): master 16-bit write, or slave read. */
DRIVE_DI = (MASTER_ACTIVE & MASTER_WRITE & XFR16) # (SLAVE & !S100_sWO & SLAVE_WIN);

/* Which S-100 lane feeds each AD byte on a read/slave-write. */
AD_EVEN_SRC_DO = (MASTER_ACTIVE & !MASTER_WRITE & XFR16) # (SLAVE & S100_sWO & SLAVE_WIN & !BYTE_SEL);
AD_EVEN_SRC_DI = (MASTER_ACTIVE & !MASTER_WRITE & !XFR16 & !BYTE_SEL);
AD_ODD_SRC_DI  = (MASTER_ACTIVE & !MASTER_WRITE & (XFR16 # BYTE_SEL));
AD_ODD_SRC_DO  = (SLAVE & S100_sWO & SLAVE_WIN & BYTE_SEL);

/* *************** BYTE MUX *************** */
/* The Z280 byte-swap puts even (A0=0) on AD8-15, odd (A0=1) on AD0-7. */
AD0  = (AD_ODD_SRC_DI & S100_DI0) # (AD_ODD_SRC_DO & S100_DO0);
AD1  = (AD_ODD_SRC_DI & S100_DI1) # (AD_ODD_SRC_DO & S100_DO1);
AD2  = (AD_ODD_SRC_DI & S100_DI2) # (AD_ODD_SRC_DO & S100_DO2);
AD3  = (AD_ODD_SRC_DI & S100_DI3) # (AD_ODD_SRC_DO & S100_DO3);
AD4  = (AD_ODD_SRC_DI & S100_DI4) # (AD_ODD_SRC_DO & S100_DO4);
AD5  = (AD_ODD_SRC_DI & S100_DI5) # (AD_ODD_SRC_DO & S100_DO5);
AD6  = (AD_ODD_SRC_DI & S100_DI6) # (AD_ODD_SRC_DO & S100_DO6);
AD7  = (AD_ODD_SRC_DI & S100_DI7) # (AD_ODD_SRC_DO & S100_DO7);
AD8  = (AD_EVEN_SRC_DO & S100_DO0) # (AD_EVEN_SRC_DI & S100_DI0);
AD9  = (AD_EVEN_SRC_DO & S100_DO1) # (AD_EVEN_SRC_DI & S100_DI1);
AD10  = (AD_EVEN_SRC_DO & S100_DO2) # (AD_EVEN_SRC_DI & S100_DI2);
AD11  = (AD_EVEN_SRC_DO & S100_DO3) # (AD_EVEN_SRC_DI & S100_DI3);
AD12  = (AD_EVEN_SRC_DO & S100_DO4) # (AD_EVEN_SRC_DI & S100_DI4);
AD13  = (AD_EVEN_SRC_DO & S100_DO5) # (AD_EVEN_SRC_DI & S100_DI5);
AD14  = (AD_EVEN_SRC_DO & S100_DO6) # (AD_EVEN_SRC_DI & S100_DI6);
AD15  = (AD_EVEN_SRC_DO & S100_DO7) # (AD_EVEN_SRC_DI & S100_DI7);
AD0.OE = DRIVE_AD;
AD1.OE = DRIVE_AD;
AD2.OE = DRIVE_AD;
AD3.OE = DRIVE_AD;
AD4.OE = DRIVE_AD;
AD5.OE = DRIVE_AD;
AD6.OE = DRIVE_AD;
AD7.OE = DRIVE_AD;
AD8.OE = DRIVE_AD;
AD9.OE = DRIVE_AD;
AD10.OE = DRIVE_AD;
AD11.OE = DRIVE_AD;
AD12.OE = DRIVE_AD;
AD13.OE = DRIVE_AD;
AD14.OE = DRIVE_AD;
AD15.OE = DRIVE_AD;
S100_DO0 = (BYTE_SEL & AD0) # (!BYTE_SEL & AD8);
S100_DO1 = (BYTE_SEL & AD1) # (!BYTE_SEL & AD9);
S100_DO2 = (BYTE_SEL & AD2) # (!BYTE_SEL & AD10);
S100_DO3 = (BYTE_SEL & AD3) # (!BYTE_SEL & AD11);
S100_DO4 = (BYTE_SEL & AD4) # (!BYTE_SEL & AD12);
S100_DO5 = (BYTE_SEL & AD5) # (!BYTE_SEL & AD13);
S100_DO6 = (BYTE_SEL & AD6) # (!BYTE_SEL & AD14);
S100_DO7 = (BYTE_SEL & AD7) # (!BYTE_SEL & AD15);
S100_DO0.OE = DRIVE_DO;
S100_DO1.OE = DRIVE_DO;
S100_DO2.OE = DRIVE_DO;
S100_DO3.OE = DRIVE_DO;
S100_DO4.OE = DRIVE_DO;
S100_DO5.OE = DRIVE_DO;
S100_DO6.OE = DRIVE_DO;
S100_DO7.OE = DRIVE_DO;
S100_DI0 = ((XFR16 # BYTE_SEL) & AD0) # (!(XFR16 # BYTE_SEL) & AD8);
S100_DI1 = ((XFR16 # BYTE_SEL) & AD1) # (!(XFR16 # BYTE_SEL) & AD9);
S100_DI2 = ((XFR16 # BYTE_SEL) & AD2) # (!(XFR16 # BYTE_SEL) & AD10);
S100_DI3 = ((XFR16 # BYTE_SEL) & AD3) # (!(XFR16 # BYTE_SEL) & AD11);
S100_DI4 = ((XFR16 # BYTE_SEL) & AD4) # (!(XFR16 # BYTE_SEL) & AD12);
S100_DI5 = ((XFR16 # BYTE_SEL) & AD5) # (!(XFR16 # BYTE_SEL) & AD13);
S100_DI6 = ((XFR16 # BYTE_SEL) & AD6) # (!(XFR16 # BYTE_SEL) & AD14);
S100_DI7 = ((XFR16 # BYTE_SEL) & AD7) # (!(XFR16 # BYTE_SEL) & AD15);
S100_DI0.OE = DRIVE_DI;
S100_DI1.OE = DRIVE_DI;
S100_DI2.OE = DRIVE_DI;
S100_DI3.OE = DRIVE_DI;
S100_DI4.OE = DRIVE_DI;
S100_DI5.OE = DRIVE_DI;
S100_DI6.OE = DRIVE_DI;
S100_DI7.OE = DRIVE_DI;

/* *************** BUFFER CONTROL *************** */
/* Address/status/control 245s: drive in master, receive in slave; the TMA
 * floats the drive direction via the disable lines. */
S100_A_DIR  = !SLAVE;
S100_SC_DIR = !SLAVE;
S100_A_OE   = S100_ADSB # SLAVE;
S100_S_OE   = S100_SDSB # SLAVE;
S100_C_OE   = S100_CDSB # SLAVE;

/* *************** SLAVE HANDSHAKE (open-drain) *************** */
/* pRDY/XRDY (active high): pull low = wait; release = ready. Always ready. */
RDY_WAIT = 0;
S100_pRDY    = 0;
S100_pRDY.OE = SLAVE & SLAVE_WIN & S100_sMEMR & RDY_WAIT;
S100_XRDY    = 0;
S100_XRDY.OE = SLAVE & SLAVE_WIN & S100_sMEMR & RDY_WAIT;

/* SIXTN (active low): pull low = ack a TMA's sXTRQ. */
S100_SIXTN    = 1;
S100_SIXTN.OE = SLAVE & S100_sXTRQ & SLAVE_WIN;

/* *************** ADDRESS DECODE (-> A) *************** */
/* 2 MB SRAM window (000000-1FFFFF) = slave window; bank select is A20. */
SLAVE_WIN = !A23 & !A22 & !A21;
SRAM_WIN  = SLAVE_WIN;
FLASH_WIN = A23 & A22 & A21 & A20 & !A19 & !A18;
BANK = A20;

