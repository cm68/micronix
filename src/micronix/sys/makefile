#
# micronix makefile for compiling the kernel with ccc (native build)
#
# micronix/sys/makefile
#
# Changed: <2026-10-03>
#
# This runs inside micronix, under the make in cmd/make - the v7 make
# ported to this tree - against the compiler in /bin/ccc.  GNUmakefile
# beside it cross builds the same image on the host, and the lists below
# are that file's, group for group: the two build the same files, so a
# difference between them is a real one.  ccc runs natively and drives
# the assembler as well as the compiler, so an .s and a .c are the same
# command here, and the flat link (ld -Ttext) replaces the old
# Whitesmith's overlay link (link -tb0x1000 -r low.o io.o high.o).
#
# Three things this make is not, and the shape of the file follows from
# them:
#
#	There are no pattern rules.  "%.o: %.c" would be a rule for a file
#	named "%.o", so an object is made only by a rule that names it, and
#	that name is on a list here.  A .s or .c that is not on one of
#	these lists is never assembled or compiled, and a source that is
#	missing is an error rather than a reason to reach for the file of
#	the same stem that another build happened to leave in the
#	directory.  A listing generated by ccc and left lying beside its
#	.c is the case this is for.
#
#	There is no substitution reference.  $(SRC:.s=.o) expands to
#	nothing, so the .o names are written out under each source list.
#	Keep the two in step - an object on no list is never built.
#
#	$* in a prerequisite is expanded per target (make.1), so one rule
#	over a list of objects reaches each one's own source: in
#	"mount.o: $*.c", $* is mount.  The same reaches a driver's header
#	and object from its .mod: in "dj.mod: $*hdr.o $*.o unix.link",
#	$* is dj.
#
# vim: tabstop=4 shiftwidth=4 noexpandtab:

#
# No suffix rules.  Every object has an explicit rule below, and the
# parser fills $* from the target name minus its extension (doname's
# stemof), so the suffix machinery is not needed for the .o, .mod and
# .page rules either.  Without this, doname's search for a prerequisite's
# source tries every suffix in the built-in list and makes a nameblock
# for each candidate, which is most of what the heap grows by after the
# makefile is parsed.
#
.SUFFIXES:

INC = ../include
SYS = ../include/sys

# Both are the tree's own tools, under the names this host gives them.
# The linker is one source built twice: on the host it is mxld, because
# "ld" there is the system's linker and not this one, and here it is
# plain ld, because on micronix it is the system's (ccc's
# src/tools/GNUmakefile builds both).  There is no mxld on the disk, and
# make searches only ".", /bin and /usr/bin - cmd/make/dosys.c - so the
# wrong name is not a lint, it is "Cannot load mxld.  Stop."
CC = ccc
LD = ld

# -O is the peephole pass.  -i replaces the include directory rather than
# adding to it, so the kernel's own headers are the only ones in view.
# The directory is written attached to the flag: ccc hands "-i" straight
# to cpp and does not read an argument after it, so "-i ../include" is an
# -i with no directory and "../include" a second input file - ccc stops
# with "unknown file type".  GNUmakefile writes it this way too.
#
# -DOVLSEG names the segment the overlay frame is in; sys/ovl.h's
# OVLBASE is OVLSEG * 0x1000 and the module links below are told the same
# address by -Tdata, so the two have to agree.  -DN8259=2 is the interrupt
# topology (include/sys/ints.h): the d1's two 8259s.  Polled vs vectored
# is no longer a C flag - one kernel discovers the board at boot.
CFLAGS = -m micronix -O -DOVLSEG=13 -DN8259=2 -i$(INC)/

#
# The overlay frame.  OVLBASE is the one segment a driver module is
# mapped into (0xd000, above the scratch and buffer pools).  It is the
# literal GNUmakefile computes out of OVLSEG (13) and names outright.
# The data segment itself follows the text, so there is no separate data
# origin to name.
#
OVLBASE = 0xd000
PAGESZ  = 4096

#
# The u page (see user.c), all of it .data at 0xf000: the hand-written
# leaf code (these sat in leaf/ until that directory was flattened), then
# the libccc runtime copied from src/libc and re-sectioned to psect data,
# then the read-only kernel tables.
#
UPAGE_AS_SRC   = mem.s inout.s sub8.s unixtobcd.s slavevec.s
UPAGE_AS_OBJ   = mem.o inout.o sub8.o unixtobcd.o slavevec.o

UPAGE_LIBC_SRC = csv.s idiv.s imul.s qadd.s qsub.s qand.s qor.s qcmp.s \
	qshl.s qsar.s qshr.s qmul.s qinc.s qldst.s tramp.s swdisp.s \
	swdispw.s oarg.s
UPAGE_LIBC_OBJ = csv.o idiv.o imul.o qadd.o qsub.o qand.o qor.o qcmp.o \
	qshl.o qsar.o qshr.o qmul.o qinc.o qldst.o tramp.o swdisp.o \
	swdispw.o oarg.o

UPAGE_C_SRC    = consts.c bus.c
UPAGE_C_OBJ    = consts.o bus.o

#
# The resident kernel.
#
KERNEL_AS_SRC = uhdr.s intrpt.s mio.s textpad.s
KERNEL_AS_OBJ = uhdr.o intrpt.o mio.o textpad.o

KERNEL_C_SRC  = mount.c balloc.c cio.c create.c exec.c fio.c fork.c \
	ialloc.c iget.c imap.c malloc.c name.c queue.c \
	reg.c sig.c sleep.c subc.c swap.c sys1.c system.c time.c \
	trap.c tty.c uio.c multio.c ss1_uart.c dlabel.c ovl.c main.c \
	upd1990.c ss1_clock.c picdata.c
KERNEL_C_OBJ  = mount.o balloc.o cio.o create.o exec.o fio.o fork.o \
	ialloc.o iget.o imap.o malloc.o name.o queue.o \
	reg.o sig.o sleep.o subc.o swap.o sys1.o system.o time.o \
	trap.o tty.o uio.o multio.o ss1_uart.o dlabel.o ovl.o main.o \
	upd1990.o ss1_clock.o picdata.o

#
# The window-page cluster, folded to .data at 0xe000 (BUFWIN) by win.o's
# rule: the code that runs with the buffer window in place, and memdev.
#
WIN_C_SRC = open.c sys2.c rdwri.c memdev.c link.c access.c
WIN_C_OBJ = open.o sys2.o rdwri.o memdev.o link.o access.o

#
# Init-only code, folded into data-only highmem.o by the rule below and
# reclaimed as buffer headers by expand_bufs() once init has returned.
# The disk drivers' own bring-up (djinit, ncrinit) lives here, out of
# their one-page modules, and so does the whole PIC/probe bring-up.
#
HIGHMEM_C_SRC  = main_init.c cus.c djinit.c ncrinit.c pic_init.c \
	probe_init.c upd1990_init.c ss1clk_init.c picvec.c
HIGHMEM_C_OBJ  = main_init.o cus.o djinit.o ncrinit.o pic_init.o \
	probe_init.o upd1990_init.o ss1clk_init.o picvec.o

HIGHMEM_AS_SRC = inits.s unbcd.s ss1vec.s
HIGHMEM_AS_OBJ = inits.o unbcd.o ss1vec.o

# The u struct itself, which lives in the u page's segment (USERSEG).
USER_C_SRC = user.c
USER_C_OBJ = user.o

# The code that is folded to .data and rides the u page: pic.c's resident
# half (pic_eoi, inton) and net.c's /dev/net framing.
PIC_C_SRC = pic.c
PIC_C_OBJ = pic.o
NET_C_SRC = net.c
NET_C_OBJ = net.o

#
# The disk drivers, each a module of its own: a driver .c and a header
# .c, linked together into a page at OVLBASE and stamped into the bootable
# image (see the module rules at the end).
#
MODS    = dj mw ide ncr hdca nd disk1 disk2 disk3
MOD_OBJ = dj.o mw.o ide.o ncr.o hdca.o nd.o disk1.o disk2.o disk3.o
MOD_HDR = djhdr.o mwhdr.o idehdr.o ncrhdr.o hdcahdr.o ndhdr.o \
	disk1hdr.o disk2hdr.o disk3hdr.o

#
# upd1990.c is ordinary resident C: its only callers are mount() and sys2.c,
# which are resident, so no driver module links against it and it needs
# no fold.  It lived in the u page - pure code with no static data, so
# it could be parked there with the runtime - until the leaf code grew
# past what the page holds.
#

#
# The objects, in the order the links need them.  highmem.o, upage.o,
# win.o and low.o are links of their own, not compiles, so they are named
# with the links.
#
LEAF_AS   = $(UPAGE_AS_OBJ) $(UPAGE_LIBC_OBJ)
LEAF_C    = $(UPAGE_C_OBJ)
KERNEL_AS = $(KERNEL_AS_OBJ) highmem.o
KERNEL_C  = $(KERNEL_C_OBJ)
WIN_C     = $(WIN_C_OBJ)

# The fold's order is the cross build's, object for object: inits and
# unbcd land between cus and the driver inits, and the PIC bring-up after
# them.  The source lists above are only what has to be compiled.
HIGHMEM   = main_init.o cus.o inits.o unbcd.o djinit.o ncrinit.o \
	pic_init.o probe_init.o upd1990_init.o ss1clk_init.o \
	picvec.o ss1vec.o

OBJS      = $(KERNEL_AS) $(LEAF_AS) $(LEAF_C) user.o upage.o $(KERNEL_C) \
	$(WIN_C) low.o win.o ovlslot.o

MODULES = $(MOD_OBJ) $(MOD_HDR) \
	dj.mod mw.mod ide.mod ncr.mod hdca.mod \
	nd.mod disk1.mod disk2.mod disk3.mod \
	dj.page mw.page ide.page ncr.page hdca.page \
	nd.page disk1.page disk2.page disk3.page

all: unix

#
# Each object and the source of the same name, and only those.  $* is
# the target's own stem, so the rule that builds an object names its
# source too, and no rule reaches a file that is on no list above.
#
# The recipe names ccc rather than leaving the work to the built-in .s.o
# and .c.o rules: the built-in .s.o assembles with asz, and here ccc is
# what the .s are written for.
#
$(UPAGE_AS_OBJ) $(UPAGE_LIBC_OBJ) $(KERNEL_AS_OBJ) $(HIGHMEM_AS_OBJ): $*.s
	$(CC) -m micronix -c $*.s

$(KERNEL_C_OBJ) probe.o $(WIN_C_OBJ) $(HIGHMEM_C_OBJ) $(USER_C_OBJ) \
	$(MOD_OBJ) $(MOD_HDR): $*.c
	$(CC) $(CFLAGS) -c $*.c

# The u page: the leaf code first at the base of segment USERSEG, then
# user.o (the u struct) whose data is ustack (512 bytes, the system
# stack) below the u struct, all as .data placed at 0xf000.  The code
# must be .data, not .text - the loader reads text and then data, so text
# parked here would be overwritten.  pic.o and net.o are folded to data
# by their own rules below for the same reason.
upage.o: $(LEAF_AS) $(LEAF_C) $(PIC_C_OBJ) $(NET_C_OBJ) $(USER_C_OBJ)
	$(LD) -r -Tdata=0xf000 -o upage.o $(LEAF_AS) $(LEAF_C) \
		$(PIC_C_OBJ) $(NET_C_OBJ) $(USER_C_OBJ)

# highmem.o is the init-only code - main_init, cus, the drivers' bring-up
# (djinit, ncrinit), the PIC discovery, the probe and attach, the clock
# bring-up, the MIO/console init in inits.s, and bcd2unix in unbcd.s -
# folded into one data-only object with -Sdata.  The main link parks a
# data-only object after bss, so it sits at _ebss and expand_bufs() mints
# buffer headers over it once init has returned.
highmem.o: $(HIGHMEM)
	$(LD) -r -Sdata -o highmem.o $(HIGHMEM)

# consts.o is made the same way, for the same reason and one literal at a
# time: ccc compiles the device-name strings the u page's read-only
# tables point at into .text, and text in upage.o is what the final link
# pads out to the u page - tens of kilobytes of zeros in the middle of
# the image, past the blocks the boot loader reads.  Folded, upage.o has
# no text and the image is the size it has always been.
#
# bus.o (the DMA bus lock two driver modules call) and pic.o (the
# resident 8259 half) ride the u page for the same reason: a module has
# to find them in the kernel's symbol table, and the u page is resident.
consts.o: consts.c
	$(CC) $(CFLAGS) -c -o consts.rel consts.c
	$(LD) -r -Sdata -o consts.o consts.rel
	rm -f consts.rel

bus.o: bus.c
	$(CC) $(CFLAGS) -c -o bus.rel bus.c
	$(LD) -r -Sdata -o bus.o bus.rel
	rm -f bus.rel

pic.o: pic.c
	$(CC) $(CFLAGS) -c -o pic.rel pic.c
	$(LD) -r -Sdata -o pic.o pic.rel
	rm -f pic.rel

net.o: net.c
	$(CC) $(CFLAGS) -c -o net.rel net.c
	$(LD) -r -Sdata -o net.o net.rel
	rm -f net.rel

# uhdr.o must stay at 0x1000 (the firmware's entry point).  The asm
# follows the C objects: mem.s remaps segment 1 (0x1000-0x1fff) through
# MAP0[2] to reach user memory, and if it sat in that segment it would
# remap its own code out from under itself.  textpad.o is last among the
# resident objects so _ebss is the end of .bss; highmem.o (data-only)
# follows it, then win.o, then upage.o, the u page at 0xf000.
#
# THE FINAL LINK IS AN ORDINARY LINK - text, then data, then bss, with
# -Ttext=0x1000 the only address it is given - and it has
# no case for the u page and none for the init-only code.  What it places
# is decided by the -r links above it: upage.o is .data at 0xf000 by
# -Tdata, win.o is .data at 0xe000 the same way, highmem.o is the
# data-only, unplaced shape -Shigh parks after bss, and low.o is a plain
# fold that lands where the resident kernel always has.  Text has no
# address to be placed at in the u page or the window, so a .c that goes
# there is folded to .data by a rule of its own (consts.o, win.o); left
# as .text, ld appends it to the resident text and pads the text section
# out to reach 0xf000, and the image stops fitting in the blocks the boot
# loader will read.  A new object for either place is the same bargain:
# fold it upstream, because this link has nowhere to put its text.
#
# The frame is not opened by the final link - there is no -Tdata on it.
# ovlslot.o is .data at OVLBASE (0xd000) by the -r link above, so the
# final link places it there among the data, and setdev overwrites it
# with the root driver.
#
# THE LINK IS TWO LINKS BECAUSE OF THE ARGUMENT COUNT, and the count is
# the shell's.  make runs a recipe through "sh -c" when metas() finds a
# metacharacter in it - "=" is one, and -Ttext=0x1000 carries one - and msh
# collects the words of that command line into char *args[ARGSIZ]: fifty
# of them, less the five the parser keeps in hand.  The forty-eight this
# link used to be is past that, and the diagnostic is "Too many args".
# low.o folds the resident objects with a link of its own, and that line
# has no "=" in it, so make execs ld directly and the shell's array is
# never in the way.  The final link is a handful of words.
#
# The fold is a plain -r, not a section fold: text, data and bss come
# through as they are, so the one object lands exactly where the
# thirty-eight packed - _ebss still the end of textpad.o's .bss, highmem.o
# still parked after it.  The host GNUmakefile makes the same fold, so
# the two builds link the same way and an image that differs is a
# difference in the code.
#
# -L/lib because ld has no default library path: only a -L adds one
# (findlib in ld.c searches nothing else), so -lccc alone is "ld: library
# not found: ccc" and no link.  The driver is what usually supplies it -
# ccc builds a -L out of its own argv[0] and hands it over (ccc.c) - and
# a direct link has to write the flag out.
low.o: uhdr.o $(KERNEL_C) probe.o intrpt.o mio.o textpad.o
	$(LD) -r -o low.o uhdr.o $(KERNEL_C) probe.o intrpt.o mio.o textpad.o

# win.o is the window-page cluster: the part of the resident kernel that
# runs while a buffer's segment is in the BUFSEG window, folded to .data
# at 0xe000 so the final link parks it in the window's page.  -Sdata is
# upage.o's reason too, not an aesthetic: the loader writes text and then
# data in address order, so text parked up here is overwritten.
win.o: $(WIN_C)
	$(LD) -r -Sdata -Tdata=0xe000 -o win.o $(WIN_C)

# ovlslot.o is the overlay slot (sys/ovlslot.s): one page of data at
# OVLBASE, which setdev later writes the root driver's page onto.  The -r
# link is what holds it at that address; -Tdata says where the data
# segment starts, so the object's own header carries the page and the
# final link places it there.  It is data now because 0xd000 is above the
# resident data, not the page past the text.
ovlslot.o: ovlslot.s
	$(CC) $(CFLAGS) -c -o ovlslot.rel ovlslot.s
	$(LD) -r -Sdata -Tdata=$(OVLBASE) -o ovlslot.o ovlslot.rel
	rm -f ovlslot.rel

# The link, with an empty slot and no modules behind it.  It is unix.link
# and not unix because unix is the *bootable* image: the module pages are
# appended and the root driver stamped in below.
unix.link: $(OBJS)
	$(LD) -Ttext=0x1000 -Shigh -L/lib -lccc -lc \
		-o unix.link low.o highmem.o ovlslot.o win.o upage.o

#
# Driver modules, and the bootable image they go into.
#
# A module is its header first, at OVLBASE, because that is where the
# kernel reads it (ovlattach, sys/ovl.c).  -Sdata folds the driver and
# its header into one data section, and the header object is named first
# so its data lands at the front of the page.  -A resolves the module
# against unix.link, and -s drops the symbol table the page would carry.
#
dj.mod mw.mod ide.mod ncr.mod hdca.mod nd.mod disk1.mod disk2.mod \
	disk3.mod: $*hdr.o $*.o unix.link
	$(LD) -s -Sdata -Tdata=$(OVLBASE) -Aunix.link -o $@ $*hdr.o $*.o

# One module is one page.  What the link produced is a 16 byte object
# header followed by the page's bytes - all of them, because -Sdata puts
# every section there and -s leaves nothing after - so the page is what
# follows the header.  dd strips the header, and a second dd through a
# temp file pads a short module up to the 4K the kernel will read, which
# is the ordinary case.
dj.page mw.page ide.page ncr.page hdca.page nd.page disk1.page \
	disk2.page disk3.page: $*.mod
	dd if=$*.mod of=$@ bs=1 skip=16
	dd if=$@ of=$@.p bs=4096 count=1 conv=sync
	mv $@.p $@

# The bootable kernel: the link, the module pages stacked above its
# extent, and the root driver stamped into the slot.  The pages go at the
# first page boundary past the object, which setdev calls modbase and
# computes for itself out of the object's own header; setdev reads the
# major out of each page and dies if it finds no module for the root
# device.  -i stamps the driver for the kernel's own root device.
#
# The dd is the page rounding: unix.link is not a whole number of pages,
# and the module pages have to start at the next boundary or setdev's
# modbase lands inside the first one.  conv=sync pads the last block with
# zeros to the block size, which is the same thing the host build's
# truncate does.
unix: unix.link dj.page mw.page ide.page ncr.page hdca.page nd.page \
	disk1.page disk2.page disk3.page
	dd if=unix.link of=unix bs=4096 conv=sync
	cat dj.page mw.page ide.page ncr.page hdca.page nd.page \
		disk1.page disk2.page disk3.page >> unix
	setdev -i unix

# makedate is a micronix program like everything else here, and it
# compiles against the kernel's headers for the same reason: with no -i
# ccc searches its own include directory, whose <time.h> declares
# struct tm, and the file's struct time is then an unknown tag - every
# field access in it is a bad op.  It links rather than -c, because the
# build runs it.
makedate: makedate.c
	$(CC) $(CFLAGS) -o makedate makedate.c

# makedate writes build.h, and main_init.c includes it for the date the
# kernel prints.  cmd/make has no .PHONY, so this is not remade every
# build: build.h is written once and kept, and removing it puts a new
# date in the kernel.
build.h: makedate
	./makedate

install: unix

# The cross GNUmakefile's split: clean removes the intermediates, and
# clobber takes the targets as well.
#
# Not *.o.  A glob has to be expanded by the shell, and make sends a line
# to the shell only when it has a metacharacter in it - so
# "rm -f *.o upd1990.rel" became one shell command whose argument list
# was however many names the glob came to.  The shell caps a command at
# MAXARG words, and this was 71 of them: it printed "too many
# arguments", abandoned the rm, and then read on from the word that had
# not fitted, which is how a clean run came to say "m87.o: Command not
# found." and remove nothing at all.  Over the cap the failure is not a
# truncated rm, it is no rm plus a bogus command.
#
# The clean is many short rm lines.  It used to be one 1084-character
# rm, and the shell that ran it kept only the tail: the first 630
# characters (the resident objects) were lost, so a clobber that said it
# had run left the kernel objects behind and the next build reused them.
# cmd/sh's limits are bigger now - 512 words, 8K of words, a 2K line -
# but short lines do not depend on them and cannot trip MAXARG.
clean:
	rm -f low.o highmem.o upage.o win.o ovlslot.o user.o
	rm -f $(KERNEL_AS_OBJ) $(LEAF_C) probe.o pic.o net.o
	rm -f mem.o inout.o sub8.o unixtobcd.o slavevec.o csv.o idiv.o
	rm -f imul.o qadd.o qsub.o qand.o qor.o qcmp.o qshl.o qsar.o
	rm -f qshr.o qmul.o qinc.o qldst.o tramp.o swdisp.o swdispw.o oarg.o
	rm -f mount.o balloc.o cio.o create.o exec.o fio.o fork.o ialloc.o
	rm -f iget.o imap.o malloc.o name.o queue.o reg.o sig.o sleep.o
	rm -f subc.o swap.o sys1.o system.o time.o trap.o tty.o uio.o
	rm -f multio.o ss1_uart.o dlabel.o ovl.o main.o upd1990.o
	rm -f ss1_clock.o picdata.o open.o sys2.o rdwri.o memdev.o link.o
	rm -f access.o $(HIGHMEM)
	rm -f $(MOD_OBJ) $(MOD_HDR)
	rm -f dj.mod mw.mod ide.mod ncr.mod hdca.mod
	rm -f nd.mod disk1.mod disk2.mod disk3.mod
	rm -f dj.page mw.page ide.page ncr.page hdca.page
	rm -f nd.page disk1.page disk2.page disk3.page
	rm -f consts.rel bus.rel pic.rel net.rel ovlslot.rel
	rm -f *.nam *.tok *.x

# clobber is clean plus the kernel, the makedate host program, and
# build.h, the one file here that is written rather than compiled.
# build.h is why the split matters: makedate writes it once and nothing
# remakes it, so a clean that took it along would quietly put a new date
# in the kernel on the next build.
clobber: clean
	rm -f unix unix.link makedate build.h

# dependencies generated by
#
# fgrep '#include' *.c | tr -d '"' | sed 's/#include//' | awk '
#	{ if ($1 != f) { printf("\n%s", $1); f = $1 } }
#	{ printf(" %s", $2) }
# END { printf("\n") }
# '

access.o: $(SYS)/sys.h $(SYS)/inode.h $(SYS)/mount.h $(SYS)/proc.h
balloc.o: $(SYS)/sys.h $(SYS)/buf.h $(SYS)/proc.h
cio.o: $(SYS)/sys.h $(SYS)/con.h $(SYS)/file.h $(SYS)/inode.h $(SYS)/proc.h
create.o: $(SYS)/sys.h $(SYS)/inode.h $(SYS)/proc.h
cus.o: $(SYS)/sys.h $(SYS)/tty.h $(SYS)/ints.h
dj.o: $(SYS)/sys.h $(SYS)/buf.h $(SYS)/con.h $(SYS)/proc.h
djhdr.o: $(SYS)/sys.h $(SYS)/ovl.h
djinit.o: $(SYS)/sys.h $(SYS)/proc.h
dlabel.o: $(SYS)/sys.h $(SYS)/buf.h $(SYS)/dlabel.h $(SYS)/proc.h
exec.o: $(SYS)/sys.h $(SYS)/inode.h $(SYS)/proc.h $(SYS)/buf.h $(INC)/obj.h
