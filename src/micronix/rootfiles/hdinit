echo
mkfs -f -2048 /dev/hda
fsck /dev/hda -t
mount /dev/hda /b
chmod 755 /b
cptree / /b -v
rm -f /b/dev/root /b/dev/swap
mknod /b/dev/root b 1 0
mknod /b/dev/swap b 1 0
setdev /b/micronix 1/0 1/0
rm -f /b/hdinit /b/m5init /b/m10init /b/m16init
rm -f /b/etc/signon
ln /b/etc/signon2 /b/etc/signon
rm -f /b/etc/signon2
umount /dev/hda
sync
echo
echo Hard disk initialization complete.
