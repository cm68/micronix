echo
mwformat -m m40 /dev/hd0c
mkfs -f -1024 /dev/hd0a
fsck /dev/hd0a -t
mount /dev/hd0a /b
chmod 755 /b
cptree / /b -v
# rm -f, not the Whitesmiths era: this tree has never built era, and an
# erase that fails here leaves the new disk's /dev/root on the floppy.
rm -f /b/dev/root /b/dev/swap
mknod /b/dev/root b 3 16
mknod /b/dev/swap b 3 16
setdev /b/micronix 3/16 3/16
rm -f /b/hdinit /b/m5init /b/m10init /b/m16init /b/m40init
rm -f /b/etc/signon
ln /b/etc/signon2 /b/etc/signon
rm -f /b/etc/signon2
umount /dev/hd0a
sync
echo
echo Disk initialization complete.
