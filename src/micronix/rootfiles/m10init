echo
label -s /dev/hd0c a 0 274
label -s /dev/hd0c b 275
mkfs -f /dev/hd0a
fsck /dev/hd0a
mount /dev/hd0a /b
chmod 755 /b
cptree -v / /b
rm -f /b/dev/root /b/dev/swap
mknod /b/dev/root b 3 0
mknod /b/dev/swap b 3 32
setdev /b/micronix 3/0 3/32
rm -f /b/hdinit /b/m5init /b/m10init /b/m16init
rm -f /b/etc/signon
ln /b/etc/signon2 /b/etc/signon
rm -f /b/etc/signon2
umount /dev/hd0a
sync
echo
echo Disk initialization complete.
