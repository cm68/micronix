echo
mkfs -f -1024 /dev/m16a
fsck /dev/m16a -t
mount /dev/m16a /b
chmod 755 /b
cptree / /b -v
era /b/dev/root /b/dev/swap
mknod /b/dev/root b 3 8
mknod /b/dev/swap b 3 8
setdev /b/micronix 3/8 3/8
era /b/hdinit /b/m5init /b/m10init /b/m16init
era /b/etc/signon
ln /b/etc/signon2 /b/etc/signon
era /b/etc/signon2
umount /dev/m16a
sync
echo
echo Disk initialization complete.
