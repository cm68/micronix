#
# COMPILERBUGS - what the compiler gets wrong, with a repro for each
#
# micronix/libexec/COMPILERBUGS
#
# Every entry below was a defect in this tree's compiler - mxccc, over
# the passes in libexec - found by porting a command and reduced to a
# program small enough to run in a minute.  The first five numbered
# entries were fixed on 2026-09-30; the workaround each one recorded is
# now a description of how the bug looked before the fix, kept because
# that is the shape the tree's sources still avoid in the places the
# port worked around them.  Entry 6 is open: the kernel code that found
# it no longer asks for the conversion, but the compiler still gets it
# wrong.  Entries 7 and 8 were fixed on 2026-11-03: the sources that
# found them still avoid the shapes, but no longer have to.  The unnumbered section at the end is not a miscompile and is
# left as it was.
#
# The 2026-09-30 fixes were each checked with its repro and with a
# self-host pass - every compiler source, host output and simulated
# output, byte-identical.  Entries 7 and 8 (2026-11-03) have their
# repros, a full rebuild - passes, libraries, kernel, commands - with
# unrelated programs linking byte-identical, and the footprint run
# (make -C src/micronix footprint) after them: every pass fits every
# source with no gap under 256, the tightest being c1 compiling its own
# lower.c at 350 bytes.
#
# Each one was re-run against the tree's own mxccc while this file was
# written, and the output quoted is that run's.  Unless an entry says
# otherwise the bug was present with and without -O.
#
# Probes were compiled as
#
#   mxccc -m micronix [-O] -i<tree>/lib/include -I<tree>/include \
#         -o prog prog.c lib/libc/libc.a lib/libunix/libunix.a
#
# and run under the user-mode simulator.  Store a result in a variable
# and print the variable - handing a call result or a folded constant
# straight to a varargs printf reads the wrong word and invents bugs
# that are not there.
#
# vim: tabstop=4 shiftwidth=4 noexpandtab:
#

# ---------------------------------------------------------------------
# 1.  x > 0 FOLDS TO x + 1, under -O only          [FIXED 2026-09-30]
#
# The comparison compiles - and its VALUE is x+1, so it is only wrong
# where the result is used as a number rather than as a condition.
# while (i > 0) is unaffected; nf = 1; k = nf > 0; is not.  x > 0L is
# correct, and so are >=, != and <.  Present only with -O: the peephole
# pass is what folds it.
#
# Found porting v7 sort, which uses nfields>0 twice as a value - the k
# start in cmp() and field()'s second argument.  Rewritten nfields != 0.
#
#	#include <types.h>
#	#include <stdio.h>
#	main()
#	{
#		volatile int nf;
#		int k;
#		nf = 1;
#		k = nf > 0;
#		printf("%d\n", k);	/* 1 without -O, 2 with */
#	}

# ---------------------------------------------------------------------
# 2.  AN AGGREGATE INITIALIZER GIVES ONE INITIALIZER PER MEMBER  [FIXED 2026-09-30]
#
# Not per element: for a struct with array members, each array takes a
# single initializer and the rest of it is zeroed.  Nested braces are
# correct.  This one bit twice in the same port, and silently.
#
# Found porting v7 sort.  Its flat ten-number initializer for
# struct field left m[1] = 0 where -1 belongs, and m[1] = -1 is what
# makes a key run to the end of the line - so EVERY +pos key sorted the
# whole line and looked plausible.  The three array members are braced
# now.  The general shape:
#
#	#include <types.h>
#	#include <stdio.h>
#	struct s2 { int a[2]; int b[2]; };
#	struct s2 z = {0,-1,2,3};
#	main()
#	{
#		printf("%d %d %d %d\n", z.a[0], z.a[1], z.b[0], z.b[1]);
#		/* 0 0 -1 0; nested {{0,-1},{2,3}} gives 0 -1 2 3 */
#	}

# ---------------------------------------------------------------------
# 3.  A char AGAINST A CONSTANT >= 128 COMPARES SIGNED    [FIXED 2026-09-30]
#
# char is signed here, so any byte at or above 128 is negative and
# c < 128 is false for every ASCII character.  Mask with & 0377 when
# the intent is a byte range.
#
# Found porting v7 file, in english(): bp[j] < NASC, with NASC 128,
# made every text file report "ascii text" and none ever report
# "English text".  Written (bp[j] & 0377) < NASC.  A separate cause from
# entry 1 and present with and without -O.
#
#	#include <types.h>
#	#include <stdio.h>
#	main()
#	{
#		char c;
#		int r;
#		c = 97;
#		r = c < 128;
#		printf("%d\n", r);	/* 0; c < 127 is 1 */
#	}

# ---------------------------------------------------------------------
# 4.  cond ? 0 : <byte variable> IS ZERO-EXTENDED       [FIXED 2026-09-30]
#
# The ?: sign fix of 94f4249f covers a small constant against another
# constant (? 1 : -1) and the ? -1 : byte shape.  It does not cover a
# byte VARIABLE in the arm: the 0 wins the type and the variable is
# read unsigned, so -1 comes back 255.
#
# Found porting v7 dc, which writes this twelve times through its
# sgetc/slookc/sbackc macros.  The symptom was a byte of garbage in a
# printed number (chsign stored 251 for the digit 5).  An (int) cast on
# the arm fixes all twelve and leaves dc's expressions alone.
#
#	#include <types.h>
#	#include <stdio.h>
#	char cbuf[4];
#	int gi, n;
#	main()
#	{
#		int i;
#		cbuf[0] = -1;
#		i = 0;
#		n = i ? 0 : cbuf[0];
#		printf("%d\n", n);	/* 255 */
#		n = cbuf[0];
#		printf("%d\n", n);	/* -1 - the same value, read plainly */
#	}

# ---------------------------------------------------------------------
# 5.  register LOCALS SHARING AN EXPRESSION WITH A ?: OPERAND LOSE A
#     CONSTANT                                         [FIXED 2026-09-30]
#
# With register on the locals, c1 drops the 100 out of
# "ct=100-slookc(p)-carry" and the byte that comes back is whatever the
# caller left in HL.  The trigger is the combination: register on a
# local AND an operand that is itself a ?: expression.  Entry 4's macro
# is such an operand, so dc's chsign hits it.  The same expression with
# a plain dereference instead of the macro is fine (D below), and plain
# locals are fine (B below).
#
# Found porting v7 dc.  Its chsign had v7's "register int carry;
# register char ct;" and negating 5 stored 251.  Both are plain locals
# now.  Measured with the probe below, where all four should print 95.
# The numbers quoted are the -O ones; without -O they differ again
# (A 97, C 5217), because the garbage is whatever the caller left in
# HL and the peephole changes who left it:
#
#   A  69    register int carry; register char ct;   (the macro)
#   B  95    int carry; char ct;                      (the macro)
#   C  5189  register int carry; int ct;              (the macro)
#   D  95    register int carry; register char ct;   (no macro)
#
#	#include <types.h>
#	#include <stdio.h>
#	#define EOF2 (-1)
#	struct blk { char *rd, *wt, *beg, *last; };
#	struct blk b;
#	char store[8];
#	int gi;
#	#define sfeof(p) (((p)->rd==(p)->wt)?1:0)
#	#define slookc(p) (((p)->rd==(p)->wt)?EOF2:*(p)->rd)
#	int A(p, j)
#	struct blk *p;
#	int j;
#	{
#		register int carry;
#		register char ct;
#		carry = 0;
#		ct = 100 - slookc(p) - carry;
#		return (ct);
#	}
#	int B(p, j)
#	struct blk *p;
#	int j;
#	{
#		int carry;
#		char ct;
#		carry = 0;
#		ct = 100 - slookc(p) - carry;
#		return (ct);
#	}
#	int C(p, j)
#	struct blk *p;
#	int j;
#	{
#		register int carry;
#		int ct;
#		carry = 0;
#		ct = 100 - slookc(p) - carry;
#		return (ct);
#	}
#	int D(p, j)
#	struct blk *p;
#	int j;
#	{
#		register int carry;
#		register char ct;
#		carry = 0;
#		ct = 100 - *(p->rd) - carry;
#		return (ct);
#	}
#	main()
#	{
#		b.beg = store; b.last = store + 8; b.rd = b.wt = store;
#		store[0] = 5; store[1] = 0; b.wt = store + 1;
#		b.rd = b.beg; gi = A(&b, 7); printf("A %d\n", gi);
#		b.rd = b.beg; gi = B(&b, 7); printf("B %d\n", gi);
#		b.rd = b.beg; gi = C(&b, 7); printf("C %d\n", gi);
#		b.rd = b.beg; gi = D(&b, 7); printf("D %d\n", gi);
#	}
#
# The unused j is the original probe's and is left in: the garbage that
# comes back is whatever the caller left in HL, so the exact numbers
# depend on the surrounding code.  What matters is that A and C are not
# 95 and that B and D are.

# ---------------------------------------------------------------------
# 6.  A POINTER ASSIGNED TO A LONG LEAVES THE HIGH WORD STALE      [OPEN]
#
# A 32-bit value lives in HL':HL, the high word in HL'.  Widening a
# word to a long has to fill HL' in, and for an unsigned word that is a
# zero: "UINT32 g; unsigned u; g = u;" emits ld hl,(_u); exx; ld hl,0.
# emitOperand() in pass1 (c0/outast.c) skipped that conversion for
# anything flagged TF_POINTER, so "g = p;" stored the pointer in the
# low word and took the high word from HL' as it stood - whatever the
# last 32-bit operation left there.
#
# The exclusion is there for arrays and functions, whose type size is
# an element size and not the width of the value: an array member
# returned from a function had picked up a SEXT of its first element.
# An array carries TF_POINTER as well as TF_ARRAY (it decays to one),
# so TF_ARRAY|TF_FUNC already keeps that case out.  A plain pointer's
# size is the address size, and it has to widen like any other word.
#
# Found chasing a directory-size corruption in the kernel.  dlook() in
# sys/name.c advanced a struct dir * alongside the entry pointer as an
# entry counter - place++ carried the 16 bytes per entry for free - and
# assigned it to the 32-bit u.offset.  The high word came out as
# whatever the previous 32-bit operation left in HL' (0xfffc in that
# run), iwrite() recorded it as the directory's size, and every create
# in /tmp then failed EFBIG.  dlook() counts byte offsets now and the
# kernel no longer asks for the conversion; the compiler still gets it
# wrong.
#
#	#include <types.h>
#	#include <stdio.h>
#	UINT32 g;
#	UINT32 l;
#	char *p;
#	main()
#	{
#		l = 0x34000000L;
#		l = l >> 8;		/* leaves 0x0034 in HL' */
#		p = (char *) 0x1234;
#		g = p;			/* the high word must be zero */
#		printf("%x %x\n", (UINT) (g >> 16), (UINT) (g & 0xffff));
#	}
#
# The shift is only there to put a known value in HL'; the assignment
# does not touch it.  A correct build prints "0 1234"; this one prints
# "34 1234", with and without -O.

# ---------------------------------------------------------------------
# 7.  *p++ = <ADDRESS OF A LOCAL ARRAY> HAS NO CODE RULE     [FIXED 2026-11-03]
#
# The store of a local aggregate's address through a post-incremented
# pointer is an expression c1 cannot build.  It reports
#
#	/tmp/cc1_0.s: 1 expression(s) that no rule could build code for
#	                 - the output is missing them
#	Error: c1 failed on prog.c
#
# and the object is not written, so the build stops there.  The same
# store of a GLOBAL array is fine; a separate increment is fine
# (p[0] = x; p++); and a char * temporary is fine (q = x; *p++ = q).
# What is not fine is the increment and the aggregate's address in the
# one store, with and without -O.
#
# Found porting inetd, which builds its exec argv with
#
#		*p++ = s->arg[j];
#		...
#		*p++ = ipstr;
#
# ipstr is a local char[18], and the second store took the whole
# compile down.  The source walks a char * temporary now:
#
#		ps = s->arg[j];
#		*p++ = ps;
#
# It was first seen as "av[1 + s->narg] = ..." - a member expression in
# a subscript - which is the same no-rule failure and the same
# workaround: compute the index (or assign through a temporary) and the
# code builds.
#
#	#include <types.h>
#	main()
#	{
#		char x[18];
#		char *av[16];
#		char **p;
#
#		p = av;
#		*p++ = x;		/* c1 cannot build this store */
#	}
#
# Make x static and it compiles.  Split the increment out and it
# compiles.  Copy x's address into a char * first and it compiles.
#
# The cause was islocdesc().  A bare address operand - SYMREF for a
# global's base, LOCALVAR or its (iy+d) form INDEX for a frame slot - is
# a location descriptor, and the store lowering read that as "needs no
# register, the store rule will read it in place".  That is true when
# the operand IS the location, and false when it is the VALUE: as a
# value it reduces to itself and emits nothing, and the store rules
# ((V,num), (V,A), (V,H), the =(D(..),..) family) name no address form.
# The tree reached the matcher as ASSIGN(DEREF(HL), INDEX(IY-54)) with
# nothing to match.
#
# Fixed in c1/lower.c with needsspill(): the address forms count as
# needing a register on the value side, so the existing spill path
# stages the destination and lets valtohl() form the value in HL.  When
# the destination is itself a descriptor and needs no staging, the same
# two forms are materialized with valtohl() where they stand, and the
# (V,H)/(I,H) store rule writes the result.
#
# Checked with this repro and with "*pp = x" (a destination held in a
# frame slot, value a local array - the same failure by the other
# branch).  The compiler's own passes (pass0, c0, c1) and cp, tar, sh,
# make, sed, awk, cpp and df rebuild, and rshd and ftpd - neither of
# which contains the shape - link to bytes identical to their build
# before the fix.

# ---------------------------------------------------------------------
# NOT A MISCOMPILE - a diagnostic that is missing
#
# A literal TAB inside a string or character constant is not valid C,
# and the compiler should reject it.  ccc accepts it and silently
# converts the tab byte to a space, so
#
#   printf("A<TAB>B\n");   /* the <TAB> is a real tab byte */
#
# prints "A B" where printf("A\tB\n") prints the tab.  Both compile with
# no warning.  The fault is the source's - write \t - but a compiler
# that takes the input without a word is why it goes unnoticed.
#
# Found porting v7 cal, whose year layout positions the month headings
# with literal tabs.
# ---------------------------------------------------------------------
# 8.  A CAST TO A WIDER TYPE RELABELLED AN ADDRESS IN PLACE   [FIXED 2026-11-03]
#
# "(long)p" with p a pointer relabelled the pointer's node as long: the
# cast code converted plain scalars and left everything else alone, and
# a pointer was not one of the plain ones.  The tree carried
#
#	(ASSIGN:long (LOCALVAR:long IY-4) (REGVAR:long BC))
#
# a thirty-two bit value homed in a sixteen-bit register, and c1 had no
# rule to store it.  Nothing above said the cast had happened; the node
# was simply relabelled.
#
# Found while testing the pointer-conversion diagnostic.  The p = 0 is
# what matters: it puts the pointer in a register, and a register home
# is what shows the relabel.  Without it the pointer is loaded and the
# shape does not arise, which is why this survived.
#
#	#include <types.h>
#	main()
#	{
#		char *p;
#		long l;
#
#		p = 0;
#		l = (long) p;		/* REGVAR:long BC */
#	}
#
# An address is a plain sixteen-bit value for purposes of conversion,
# and c0/pfx.c now says so: a pointer or array source takes part in a
# NARROW and in a widening (always WIDEN, never SEXT - a pointer is
# unsigned), and the width it is compared against is TS_PTR and not an
# array's extent.  "(char)arr" and "(long)arr" are the same fix seen
# from the two ends.
#
# c1 had to be told the other half: NARROW, WIDEN and SEXT over an
# (iy+d) or symbol form name registers in their rules, and the address
# form reduces to itself and emits nothing.  rewrite1() now forms such
# an operand in HL with valtohl() before the conversion.
#
# Checked with the repro, with "(char)arr", "(long)arr" and "(int)p";
# the kernel, the passes, the libraries and the commands rebuild, and
# rshd links to the same bytes as before the fix.

# ---------------------------------------------------------------------
# A POINTER STORED IN A CHAR USED TO GO UNNOTICED
#
# "char *p; char a[4]; *p = a;" assigns an address to a char.  c0 kept
# the assignment (its type was the char) and c1 met a byte store whose
# value was an array's address and answered "no rule could build code
# for" - when it got as far as c1 at all.  A char is narrower than an
# address, so the conversion has no meaning; it should be refused where
# it is written.
#
# c0 now diagnoses it at the assignment:
#
#	char c; char *p;
#	c = p;			/* error: incompatible pointer conversion */
#
#	char a[4]; char *p;
#	*p = a;			/* the same */
#
# ER_E_PT's message was "ptr compat" and is now "incompatible pointer
# conversion" (errorcodes, regenerated into error.h).  The check,
# ptrassign() in c0/eutil.c, is directional.  An address into an
# integer at least as wide as one is the K&R address-in-an-int this
# machine and this tree use; an integer into an address is the
# signal() SIG_IGN idiom, "slist[SIGTINT] = 1".  Neither is diagnosed.
# A zero is the null pointer constant wherever it is written, chained
# assignments included - "i_count = i_mount = 0" was the kernel's case -
# and a cast states the conversion and is left alone.
#
# Two kernel sources had relied on the silence.  sig() read a signal
# disposition's low byte with "s = u.p->slist[0]" and now says
# "(UINT8)"; the chained zero in iget() is what zeroval() allows.
#
# Not covered: initialization ("char c = p;") and call arguments go
# through other paths and are still silent.
# ---------------------------------------------------------------------
# AN ADDRESS WIDENED TO A LONG IS DIAGNOSED
#
# There is no value wider than an address here: the machine is sixteen
# bits.  Putting an address in a long is therefore a statement about
# representation that the source chose to make, and it is always worth
# a second look - the kernel's own instance (dlook() in sys/name.c
# counting a struct dir * into u.offset, entry 6) was a defect, and the
# compiler itself has no legitimate use for it.
#
# Both forms now warn, at the cast and at the implicit assignment:
#
#	char *p; long l;
#	l = (long) p;		/* warning: address widened ... */
#	l = p;			/* the same */
#
# A conversion through a word, "(long)(UINT)p", states the intent and
# is not warned about, and same-width conversions - "(int)p", "(char)p"
# - are not widening and are not either.
