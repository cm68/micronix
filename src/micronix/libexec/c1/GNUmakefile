#
# cross build for c1 - the code generator: an AST in, Z80 assembly out.
#
# cmd/c1/GNUmakefile
#
# PROTOTYPE.  The compiler is moving into this tree, and this is the
# shape it will have when it arrives: one directory per pass and per
# tool.  The sources live here.  They were symlinks into ~/src/ccc until
# the fork; this tree holds its own copies and is where they are
# edited now.
#
# Not in cmd/GNUmakefile's DIRS.  These are host programs today, built
# by gcc -m32 in the ccc tree; building them here with ccc means
# building the compiler for the Z80, which is the point of moving them
# but is not something that works yet.
#
# vim: tabstop=4 shiftwidth=4 noexpandtab:

DEPTH	= ../..
DIR	= c1
CLASS	= libexec

#
# Not /bin.  ccc runs this; nobody types it.
#
BINDIR	= /libexec

#
# The compiler's own runtime: fmtlong and libutil.  Every pass calls
# them and none of them contains them, which is what left this
# undefined at _fmtlong and _fmtstr before lib/libccc existed.
#
LIBS	= $(DEPTH)/lib/libccc/libccc.a

#
# The sources that become c1, spelled out because the framework's
# wildcard would pick up mkruleidx.c - the host program that writes
# ruleidx.c, below - and build it into the pass with ccc, where it does
# not belong.  ruleidx.c is generated by that program and is a source;
# the other seven are this tree's own, forked from ~/src/ccc/src/pass2.
#
CSRCS	= astio.c expr.c lower.c parseast.c pass2.c rewrite.c rules.c ruleidx.c

#
# What ships to the simulated filesystem.  Everything CSRCS names,
# except ruleidx.c - it is generated here from the table and generated
# there again, and a shipped copy is a second copy of the table free to
# drift - plus mkruleidx.c, so the native makefile beside this one can
# write the index the same way.
#
SRCS	= $(filter-out ruleidx.c, $(CSRCS)) mkruleidx.c $(wildcard *.h)

#
# Written at build time, removed by clobber.
#
GENERATED = ruleidx.c mkruleidx

include $(DEPTH)/GNUmakefile.inc

#
# and the same sources built for this machine: the cross compiler
# everything else in the tree is compiled by.  See libexec/host.mk.
#
HOSTPROG = c1
#
# mkruleidx.c is a host program of its own and not part of the
# pass; ruleidx.c is generated and is.
#
HOSTSRCS = $(CSRCS)

include $(DEPTH)/libexec/host.mk

#
# mkruleidx, the host program that writes the rule index from the rule
# table - see mkruleidx.c, which explains why the table is walked and
# the index not left to a comment.  It links the table itself, so it
# refuses to emit anything if any opcode's rules are not one unbroken
# run, and a misfiled rule stops the build instead of never being tried.
#
# It is a HOST program, built with gcc and not ccc: ccc builds for the
# Z80, and a program built for it cannot run on this machine.  The Z80
# rules.o beside it is of no use here, so rules.c is compiled again, by
# the host compiler, into the same binary.
#
HOSTCC	?= gcc
HOSTCFLAGS ?= -w -std=gnu89

mkruleidx: mkruleidx.c rules.c rules.h pass2.h opcodes.h lexops.h
	$(HOSTCC) $(HOSTCFLAGS) -I. -o $@ mkruleidx.c rules.c

ruleidx.c: mkruleidx rules.c
	./mkruleidx > ruleidx.c || (rm -f ruleidx.c; exit 1)
