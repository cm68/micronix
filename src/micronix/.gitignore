mxar

#
# The host build of the compiler: objects, the host libccc, the
# tracing tables makedebug.sh writes, and the tree the passes and
# driver are linked into.  All generated, none of it checked in.
#
*.ho
desthost/
lib/libccc/libccc-host.a
libexec/*/dbgtags.c
libexec/*/debug.h

#
# The compiler's per-source intermediates, written beside the .o for
# every .c: the name table (.nam), the readable tokens (.tok) and the
# tokenized source (.x).  ccc keeps its own copies in /tmp under pid
# names and deletes them; these are what an older build left in place.
#
*.nam
*.tok
*.x
