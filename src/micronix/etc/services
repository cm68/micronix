#
# /etc/services - the port names
#
# service-name	port/protocol	aliases
#
# The names the daemons and clients look up, and the two the r-services
# live on: exec 512, login 513, shell 514.  A name may be listed once
# per protocol; the lookup asks for the protocol it wants.
#
