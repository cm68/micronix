#
# cross build for awk
#
# cmd/awk/GNUmakefile
#
# awk is the 2.11BSD awk, ported with integer arithmetic (AWKFLOAT is a
# 32-bit long) because ccc has no float/double and the soft-float runtime
# would not leave room for a heap in 64k.  The two generated files are
# committed: lex.yy.c (from awk.lx.l by lex) and y.tab.c (from awk.g.y
# by yacc).  proctab.c is generated by proc (a host program, proc.c +
# token.c), which is why proc.c is not in OBJS - it is a generator, not
# part of awk, and its main() would collide.
#
# vim: tabstop=4 shiftwidth=4 noexpandtab:

DEPTH	= ../..
DIR	= awk
CLASS	= cmd

OBJS	= b.o lib.o main.o parse.o run.o token.o tran.o freeze.o popen.o \
	  intmath.o y.tab.o yylex.o proctab.o


HSRCS	= awk.h
MANSRCS	= awk.1

CSRCS	= b.c lib.c main.c parse.c run.c token.c tran.c freeze.c popen.c \
	 intmath.c y.tab.c yylex.c proctab.c

include $(DEPTH)/GNUmakefile.inc
