# cmd/booting/GNUmakefile
#
# Nothing to build: TARGET is empty, so "all" does nothing and "install"
# copies the page alone.  It is in cmd/ because that is what the system
# install walks; the page goes into section 8 with the other
# system-maintenance pages.
#
# vim: tabstop=4 shiftwidth=4 noexpandtab:

DEPTH	= ../..
DIR	= booting
CLASS	= cmd

TARGET	=
MANSEC	= 8
MANSRCS	= booting.8

include $(DEPTH)/GNUmakefile.inc
