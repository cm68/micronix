; names for /bin/fsck off the Micronix 1.6 standalone, for src/tools/disas
;
;   disas -f fsck.ctl filesystem/bin/fsck
;
; fsck is stripped - no .mx symbol table - so the names are the
; addresses read out of a first pass.  This forces the code entry
; points so disas does not dump the instruction stream as data.
;
start 0x0100

