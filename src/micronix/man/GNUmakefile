#
# man - the recovered pages
#
# man/GNUmakefile
#
# The archive pages: the 1.61 ones and the 1.3 ones off the floppy,
# including the pages for commands this tree has not built.  They are
# readable nowhere else, which is the reason for having them, and
# install-man-host mirrors them under $(MXMAN) beside mxman.
#
# This directory is NOT in the top-level DIRS, on purpose: what the
# system installs is one page per command beside its source, and the
# simulated filesystem never sees these.  Only install-man-host
# enters it.
#
# vim: tabstop=4 shiftwidth=4 noexpandtab:
#
DEPTH	= ..
DIR	= man
TARGET	=
DIRS	= man1 man2 man4 man5

include $(DEPTH)/GNUmakefile.inc
