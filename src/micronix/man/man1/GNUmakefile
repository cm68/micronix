# man/man1/GNUmakefile
#
# The pages listed here are the ones a command directory does not
# own: the pages for commands this tree has not built, and the 1982
# originals whose command has a newer page beside its source, kept
# under an old- name.  install-man-host installs them under
# $(MXMAN)/man1.
#
# vim: tabstop=4 shiftwidth=4 noexpandtab:
#
DEPTH	= ../..
DIR	= man1
TARGET	=
MANSRCS	= account.1 anat.1 archive.1 as.1 badspots.1 boot.1 cp1.1 \
	  cp2.1 cptree.1 cxr.1 dar.1 ddt.1 hex.1 lib.1 link.1 lord.1 lpr.1 \
	  msgs.1 obj.1 oldcc.1 oldowner.1 oldps.1 oldsh.1 paste.1 pilot.1 \
	  ptc.1 rp.1

include $(DEPTH)/GNUmakefile.inc
